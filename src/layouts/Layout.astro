---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = "WATCH-DOGS: Edge-Intelligent Multi-Hazard Disaster Early Warning Research Platform",
  description = "A research and engineering platform exploring distributed physical sensing, long-range LoRa mesh communications, edge computing, multi-sensor Bayesian fusion, and autonomous response intelligence.",
  activeNav = "",
} = Astro.props;

const navItems = [
  { label: "Overview", href: "/" },
  { label: "Sensing", href: "/sensing" },
  { label: "Communication", href: "/communication" },
  { label: "Intelligence", href: "/intelligence" },
  { label: "Actuation", href: "/actuation" },
  { label: "Evacuation", href: "/evacuation" },
  { label: "Architecture", href: "/architecture" },
  { label: "Hardware & BOM", href: "/hardware" },
  { label: "Circuits & Pinouts", href: "/circuits" },
  { label: "Forensic Case Studies", href: "/research" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
</head>
<body>
  <!-- Editorial Research Header -->
  <header class="research-header">
    <div class="container-fluid research-header-inner">
      <div style="display: flex; align-items: center; gap: 14px;">
        <a href="/" style="font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <img src="/disaster-photos/watchdogs_logo.jpg" alt="WATCH-DOGS Logo" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover;" />
          <span style="font-family: var(--font-mono); font-size: 0.95rem; font-weight: 900; letter-spacing: 0.05em;">WATCH-DOGS</span>
        </a>
        <span style="color: var(--border-medium);">/</span>
        <span style="color: var(--text-secondary); font-size: 0.72rem;">SIH 2026 RESEARCH PUBLICATION</span>
      </div>

      <nav style="display: flex; align-items: center; gap: 8px;">
        <ul class="nav-links">
          <li><a href="/" class={activeNav === '' || activeNav === 'index' ? 'active' : ''}>Overview</a></li>
          <li><a href="/circuits" class={activeNav === 'circuits' ? 'active' : ''}>Circuits &amp; Pinouts</a></li>
          <li><a href="/intelligence" class={activeNav === 'intelligence' ? 'active' : ''}>Edge AI</a></li>
          <li><a href="/communication" class={activeNav === 'communication' ? 'active' : ''}>LoRa Mesh</a></li>
          <li><a href="/research" class={activeNav === 'research' ? 'active' : ''}>Forensics</a></li>
        </ul>

        <!-- Bento Grid Nav Trigger Button -->
        <button type="button" id="bento-hub-toggle" class="failure-trigger-btn" style="padding: 6px 14px; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; background: #EFF6FF; border-color: #BFDBFE; color: var(--accent-primary);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
          </svg>
          <span>INDEX MATRIX</span>
        </button>
      </nav>

      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="status-badge">
          <span class="pulse-dot"></span>
          <span>AIR-GAPPED MESH</span>
        </span>
      </div>
    </div>
  </header>

  <!-- Interactive Fullscreen Bento Navigation Hub Modal -->
  <div id="bento-hub-modal" role="dialog" aria-modal="true">
    <div class="bento-hub-container">
      <div class="bento-hub-header">
        <div>
          <span class="card-badge badge-brand">SYSTEM MATRIX</span>
          <h2 style="font-size: 1.4rem; font-weight: 900; margin: 4px 0 0; letter-spacing: -0.02em;">
            Bento Grid Navigation Hub
          </h2>
        </div>
        <button type="button" class="lightbox-btn" id="bento-hub-close" style="background: #F1F5F9; color: var(--text-primary); border-color: var(--border-subtle);">
          CLOSE (ESC)
        </button>
      </div>

      <!-- Category 1: Physical Circuits & Hardware -->
      <div style="margin-bottom: 24px;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px;">
          Physical Electronics &amp; Circuit Schematics
        </div>
        <div class="bento-nav-grid" style="margin: 0;">
          <a href="/circuits" class={`bento-nav-card col-4 ${activeNav === 'circuits' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h4l2-6 4 12 2-6h4"/></svg>
              </div>
              <span class="card-badge badge-brand">4 NODES + GATEWAY</span>
            </div>
            <div class="bento-card-title">Circuits &amp; Pinout Wiremaps</div>
            <div class="bento-card-desc">Master wiring schematics for Hillside Sentinel, Riverbed Surge, Gas Sniffer, Gateway Hub &amp; MPPT Power Tree.</div>
            <div class="bento-card-footer">
              <span>VIEW SCHEMATICS</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/hardware" class={`bento-nav-card col-4 ${activeNav === 'hardware' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              </div>
              <span class="card-badge badge-safe">BOM SPECIFICATION</span>
            </div>
            <div class="bento-card-title">Hardware Architecture &amp; BOM</div>
            <div class="bento-card-desc">Component specifications, 82.7-day dark autonomy calculator, and IP67 weather-resistant enclosure.</div>
            <div class="bento-card-footer">
              <span>VIEW HARDWARE BOM</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/sensing" class={`bento-nav-card col-4 ${activeNav === 'sensing' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0"/></svg>
              </div>
              <span class="card-badge badge-warning">20 CHANNELS</span>
            </div>
            <div class="bento-card-title">In-Situ Sensing Transducers</div>
            <div class="bento-card-desc">TDR soil moisture probes, piezometer hydrostatic head, MPU6050 6-DOF IMU, and laser ToF ranging.</div>
            <div class="bento-card-footer">
              <span>EXPLORE SENSORS</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Category 2: Intelligence & Mesh Communications -->
      <div style="margin-bottom: 24px;">
        <div style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px;">
          Edge AI &amp; Air-Gapped Mesh Communications
        </div>
        <div class="bento-nav-grid" style="margin: 0;">
          <a href="/intelligence" class={`bento-nav-card col-4 ${activeNav === 'intelligence' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 3v3m0 12v3m9-9h-3M6 12H3"/></svg>
              </div>
              <span class="card-badge badge-brand">8.4ms INFERENCE</span>
            </div>
            <div class="bento-card-title">Distributed Edge Intelligence</div>
            <div class="bento-card-desc">80-dimensional feature tensor, XGBoost 2.0 classifier, and Mohr-Coulomb infinite slope physics consensus.</div>
            <div class="bento-card-footer">
              <span>INSPECT ML PIPELINE</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/communication" class={`bento-nav-card col-4 ${activeNav === 'communication' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.93 19.07a10 10 0 0 1 0-14.14M7.76 16.24a6 6 0 0 1 0-8.48M12 12h.01"/></svg>
              </div>
              <span class="card-badge badge-safe">868 MHz ISM</span>
            </div>
            <div class="bento-card-title">LoRa Mesh Radio Protocol</div>
            <div class="bento-card-desc">40km non-line-of-sight binary radio protocol with packed 32-byte frames and zero cloud dependency.</div>
            <div class="bento-card-footer">
              <span>INSPECT RF PROTOCOL</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/architecture" class={`bento-nav-card col-4 ${activeNav === 'architecture' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              </div>
              <span class="card-badge badge-brand">4-LAYER STACK</span>
            </div>
            <div class="bento-card-title">System Architecture</div>
            <div class="bento-card-desc">Full cyber-physical stack from in-situ sensor telemetry up to localized civil defense actuation.</div>
            <div class="bento-card-footer">
              <span>VIEW 4-LAYER STACK</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Category 3: Actuation, Evacuation & Forensics -->
      <div>
        <div style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px;">
          Civil Defense &amp; Forensic Research
        </div>
        <div class="bento-nav-grid" style="margin: 0;">
          <a href="/actuation" class={`bento-nav-card col-4 ${activeNav === 'actuation' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              </div>
              <span class="card-badge badge-danger">SUB-120ms TRIP</span>
            </div>
            <div class="bento-card-title">Physical Actuation &amp; Sirens</div>
            <div class="bento-card-desc">130dB civil defense sounders, motorized barrier relays, and autonomous MAVLink SAR drone dispatch.</div>
            <div class="bento-card-footer">
              <span>VIEW ACTUATORS</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/evacuation" class={`bento-nav-card col-4 ${activeNav === 'evacuation' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
              </div>
              <span class="card-badge badge-safe">DYNAMIC ROUTING</span>
            </div>
            <div class="bento-card-title">Dynamic Evacuation Guidance</div>
            <div class="bento-card-desc">A* graph search accounting for road washouts, flood contours, and real-time safe zone capacity.</div>
            <div class="bento-card-footer">
              <span>VIEW ROUTING</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>

          <a href="/research" class={`bento-nav-card col-4 ${activeNav === 'research' ? 'active' : ''}`}>
            <div class="bento-card-top">
              <div class="bento-card-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              </div>
              <span class="card-badge badge-warning">10-YEAR ARCHIVE</span>
            </div>
            <div class="bento-card-title">Forensic Disaster Case Studies</div>
            <div class="bento-card-desc">Real-world ground analyses of Wayanad 2024, Kedarnath 2013, Bhopal, and Chamoli debris flows.</div>
            <div class="bento-card-footer">
              <span>READ CASE STUDIES</span>
              <span class="bento-card-arrow">&rarr;</span>
            </div>
          </a>
        </div>
      </div>

    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="editorial-footer">
    <div class="container">
      <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; margin-bottom: 60px;">
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <img src="/disaster-photos/watchdogs_logo.jpg" alt="WATCH-DOGS Logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover;" />
            <span style="font-weight: 800; font-size: 1.2rem; color: #ffffff; font-family: var(--font-mono);">
              WATCH-DOGS
            </span>
          </div>
          <p style="line-height: 1.6; max-width: 380px; margin-bottom: 20px;">
            An open engineering &amp; physical science research initiative developing resilient, zero-cloud edge intelligence for multi-hazard disaster early warning, civil defense, and dynamic evacuation guidance.
          </p>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #71717A;">
            Smart India Hackathon 2026 &bull; Problem Statement #26178 &bull; SIH 26190 CaseVault
          </div>
        </div>

        <div>
          <h4>Core Research Pillars</h4>
          <ul>
            <li><a href="/sensing">Pillar 01: In-Situ Sensing</a></li>
            <li><a href="/communication">Pillar 02: LoRa Mesh Protocol</a></li>
            <li><a href="/intelligence">Pillar 03: Physics-AI &amp; PINN</a></li>
            <li><a href="/actuation">Pillar 04: Sub-120ms Actuation</a></li>
            <li><a href="/evacuation">Pillar 05: Dynamic Evacuation</a></li>
          </ul>
        </div>

        <div>
          <h4>System &amp; Verification</h4>
          <ul>
            <li><a href="/architecture">4-Layer Architecture</a></li>
            <li><a href="/hardware">Hardware Schematics &amp; BOM</a></li>
            <li><a href="/circuits">Circuit Diagrams &amp; Pinouts</a></li>
            <li><a href="/research">10-Year Forensic Case Studies</a></li>
          </ul>
        </div>
      </div>

      <div style="border-top: 1px solid #27272A; padding-top: 32px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; font-family: var(--font-mono); flex-wrap: wrap; gap: 12px;">
        <div>&copy; 2026 WATCH-DOGS Research Group. Open Engineering Publication.</div>
        <div>0% Cloud Reliance &bull; 100% In-Situ Physical Autonomy &bull; Sub-120ms Tripping</div>
      </div>
    </div>
  </footer>

  <!-- Universal Screen-Fit Fullscreen Image Lightbox Modal -->
  <div id="global-image-lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-topbar">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span class="card-badge badge-brand" style="padding: 4px 8px; font-size: 0.7rem;">HD SCREEN-FIT VIEW</span>
        <span id="lightbox-title" style="font-weight: 700; color: #FFFFFF; font-size: 0.85rem;">Inspection Mode</span>
      </div>
      <div class="lightbox-actions">
        <button type="button" class="lightbox-btn" id="lightbox-zoom-toggle">ZOOM (150%)</button>
        <button type="button" class="lightbox-btn" id="lightbox-close-btn" style="background: rgba(220, 38, 38, 0.4); border-color: #EF4444;">CLOSE (ESC)</button>
      </div>
    </div>

    <div class="lightbox-content-area" id="lightbox-backdrop">
      <div class="lightbox-img-wrapper" id="lightbox-wrapper">
        <img id="lightbox-image" src="" alt="Zoomed View" />
      </div>
    </div>

    <div class="lightbox-caption" id="lightbox-caption">
      Click anywhere outside or press ESC to exit screen-fit view
    </div>
  </div>

  <script is:inline>
    (function initLightbox() {
      const modal = document.getElementById('global-image-lightbox');
      const imgElem = document.getElementById('lightbox-image');
      const titleElem = document.getElementById('lightbox-title');
      const captionElem = document.getElementById('lightbox-caption');
      const closeBtn = document.getElementById('lightbox-close-btn');
      const zoomToggle = document.getElementById('lightbox-zoom-toggle');
      const wrapper = document.getElementById('lightbox-wrapper');
      const backdrop = document.getElementById('lightbox-backdrop');

      let isZoomed = false;

      function openModal(src, title, caption) {
        if (!modal || !imgElem) return;
        imgElem.src = src;
        imgElem.alt = title || 'Technical Diagram';
        if (titleElem) titleElem.textContent = title || 'Technical Schematic & Visual Proof';
        if (captionElem) captionElem.textContent = caption || (title ? `${title} — Screen-Fit High Resolution View` : 'Press ESC or Click Outside to Return');
        
        isZoomed = false;
        if (wrapper) wrapper.style.transform = 'scale(1)';
        if (zoomToggle) zoomToggle.textContent = '150% ZOOM';

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      function toggleZoom() {
        isZoomed = !isZoomed;
        if (wrapper) {
          wrapper.style.transform = isZoomed ? 'scale(1.5)' : 'scale(1)';
        }
        if (zoomToggle) {
          zoomToggle.textContent = isZoomed ? 'FIT SCREEN' : '150% ZOOM';
        }
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (zoomToggle) zoomToggle.addEventListener('click', toggleZoom);

      if (backdrop) {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop || e.target === wrapper) {
            closeModal();
          }
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
          closeModal();
        }
      });

      // Attach click-to-open handlers to all schematics, circuit diagrams, and gallery images
      function bindImages() {
        const images = document.querySelectorAll('img');
        images.forEach(img => {
          // Skip header/footer tiny logos
          if (img.width <= 40 && img.height <= 40) return;
          if (img.closest('.research-header') || img.closest('.editorial-footer')) return;
          
          img.style.cursor = 'zoom-in';
          img.title = img.title || 'Click to view screen-fit high-resolution';

          img.addEventListener('click', (e) => {
            e.stopPropagation();
            const altText = img.getAttribute('alt') || 'High-Resolution Diagram';
            const caption = img.getAttribute('data-caption') || altText;
            openModal(img.src, altText, caption);
          });
        });

        // Also bind any zoom hint buttons
        document.querySelectorAll('.zoom-hint-badge, .zoom-trigger-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const container = btn.closest('.screen-fit-container') || btn.closest('.bento-card');
            if (container) {
              const img = container.querySelector('img');
              if (img) {
                openModal(img.src, img.alt, img.alt);
              }
            }
          });
        });
      }

      // Bento Navigation Hub Interaction
      const bentoToggle = document.getElementById('bento-hub-toggle');
      const bentoModal = document.getElementById('bento-hub-modal');
      const bentoClose = document.getElementById('bento-hub-close');

      function openBentoHub() {
        if (!bentoModal) return;
        bentoModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeBentoHub() {
        if (!bentoModal) return;
        bentoModal.classList.remove('active');
        document.body.style.overflow = '';
      }

      if (bentoToggle) bentoToggle.addEventListener('click', openBentoHub);
      if (bentoClose) bentoClose.addEventListener('click', closeBentoHub);

      if (bentoModal) {
        bentoModal.addEventListener('click', (e) => {
          if (e.target === bentoModal) {
            closeBentoHub();
          }
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bentoModal && bentoModal.classList.contains('active')) {
          closeBentoHub();
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindImages);
      } else {
        bindImages();
      }
    })();
  </script>
</body>
</html>
