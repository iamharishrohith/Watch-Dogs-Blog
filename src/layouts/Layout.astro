---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = "WATCH-DOGS: Edge-Intelligent Multi-Hazard Disaster Early Warning Research Platform",
  description = "A research and engineering platform exploring distributed physical sensing, long-range LoRa mesh communications, edge computing, multi-sensor Bayesian fusion, and autonomous response intelligence.",
  activeNav = "",
} = Astro.props;

const navItems = [
  { label: "Overview", href: "/" },
  { label: "Sensing", href: "/sensing" },
  { label: "Communication", href: "/communication" },
  { label: "Intelligence", href: "/intelligence" },
  { label: "Actuation", href: "/actuation" },
  { label: "Evacuation", href: "/evacuation" },
  { label: "Architecture", href: "/architecture" },
  { label: "Hardware & BOM", href: "/hardware" },
  { label: "Circuits & Pinouts", href: "/circuits" },
  { label: "Forensic Case Studies", href: "/research" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
</head>
<body>
  <!-- Editorial Research Header -->
  <header class="research-header">
    <div class="container-fluid research-header-inner">
      <div style="display: flex; align-items: center; gap: 14px;">
        <a href="/" style="font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
          <img src="/disaster-photos/watchdogs_logo.jpg" alt="WATCH-DOGS Logo" style="width: 28px; height: 28px; border-radius: 4px; object-fit: cover;" />
          <span style="font-family: var(--font-mono); font-size: 0.95rem; font-weight: 900; letter-spacing: 0.05em;">WATCH-DOGS</span>
        </a>
        <span style="color: var(--border-medium);">/</span>
        <span style="color: var(--text-secondary); font-size: 0.72rem;">SIH 2026 RESEARCH PUBLICATION</span>
      </div>

      <nav>
        <ul class="nav-links">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class={activeNav === item.href.replace('/', '') || (item.href === '/' && activeNav === '') ? 'active' : ''}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="status-badge">
          <span class="pulse-dot"></span>
          <span>AIR-GAPPED MESH ACTIVE</span>
        </span>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="editorial-footer">
    <div class="container">
      <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; margin-bottom: 60px;">
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
            <img src="/disaster-photos/watchdogs_logo.jpg" alt="WATCH-DOGS Logo" style="width: 32px; height: 32px; border-radius: 4px; object-fit: cover;" />
            <span style="font-weight: 800; font-size: 1.2rem; color: #ffffff; font-family: var(--font-mono);">
              WATCH-DOGS
            </span>
          </div>
          <p style="line-height: 1.6; max-width: 380px; margin-bottom: 20px;">
            An open engineering &amp; physical science research initiative developing resilient, zero-cloud edge intelligence for multi-hazard disaster early warning, civil defense, and dynamic evacuation guidance.
          </p>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: #71717A;">
            Smart India Hackathon 2026 &bull; Problem Statement #26178 &bull; SIH 26190 CaseVault
          </div>
        </div>

        <div>
          <h4>Core Research Pillars</h4>
          <ul>
            <li><a href="/sensing">Pillar 01: In-Situ Sensing</a></li>
            <li><a href="/communication">Pillar 02: LoRa Mesh Protocol</a></li>
            <li><a href="/intelligence">Pillar 03: Physics-AI &amp; PINN</a></li>
            <li><a href="/actuation">Pillar 04: Sub-120ms Actuation</a></li>
            <li><a href="/evacuation">Pillar 05: Dynamic Evacuation</a></li>
          </ul>
        </div>

        <div>
          <h4>System &amp; Verification</h4>
          <ul>
            <li><a href="/architecture">4-Layer Architecture</a></li>
            <li><a href="/hardware">Hardware Schematics &amp; BOM</a></li>
            <li><a href="/circuits">Circuit Diagrams &amp; Pinouts</a></li>
            <li><a href="/research">10-Year Forensic Case Studies</a></li>
          </ul>
        </div>
      </div>

      <div style="border-top: 1px solid #27272A; padding-top: 32px; display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; font-family: var(--font-mono); flex-wrap: wrap; gap: 12px;">
        <div>&copy; 2026 WATCH-DOGS Research Group. Open Engineering Publication.</div>
        <div>0% Cloud Reliance &bull; 100% In-Situ Physical Autonomy &bull; Sub-120ms Tripping</div>
      </div>
    </div>
  </footer>

  <!-- Universal Screen-Fit Fullscreen Image Lightbox Modal -->
  <div id="global-image-lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-topbar">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span class="card-badge badge-brand" style="padding: 4px 8px; font-size: 0.7rem;">HD SCREEN-FIT VIEW</span>
        <span id="lightbox-title" style="font-weight: 700; color: #FFFFFF; font-size: 0.85rem;">Inspection Mode</span>
      </div>
      <div class="lightbox-actions">
        <button type="button" class="lightbox-btn" id="lightbox-zoom-toggle">🔍 100% ACTUAL SIZE</button>
        <button type="button" class="lightbox-btn" id="lightbox-close-btn" style="background: rgba(220, 38, 38, 0.4); border-color: #EF4444;">✕ CLOSE (ESC)</button>
      </div>
    </div>

    <div class="lightbox-content-area" id="lightbox-backdrop">
      <div class="lightbox-img-wrapper" id="lightbox-wrapper">
        <img id="lightbox-image" src="" alt="Zoomed View" />
      </div>
    </div>

    <div class="lightbox-caption" id="lightbox-caption">
      Click anywhere outside or press ESC to exit screen-fit view
    </div>
  </div>

  <script is:inline>
    (function initLightbox() {
      const modal = document.getElementById('global-image-lightbox');
      const imgElem = document.getElementById('lightbox-image');
      const titleElem = document.getElementById('lightbox-title');
      const captionElem = document.getElementById('lightbox-caption');
      const closeBtn = document.getElementById('lightbox-close-btn');
      const zoomToggle = document.getElementById('lightbox-zoom-toggle');
      const wrapper = document.getElementById('lightbox-wrapper');
      const backdrop = document.getElementById('lightbox-backdrop');

      let isZoomed = false;

      function openModal(src, title, caption) {
        if (!modal || !imgElem) return;
        imgElem.src = src;
        imgElem.alt = title || 'Technical Diagram';
        if (titleElem) titleElem.textContent = title || 'Technical Schematic & Visual Proof';
        if (captionElem) captionElem.textContent = caption || (title ? `${title} — Screen-Fit High Resolution View` : 'Press ESC or Click Outside to Return');
        
        isZoomed = false;
        if (wrapper) wrapper.style.transform = 'scale(1)';
        if (zoomToggle) zoomToggle.textContent = '🔍 150% ZOOM';

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      function toggleZoom() {
        isZoomed = !isZoomed;
        if (wrapper) {
          wrapper.style.transform = isZoomed ? 'scale(1.5)' : 'scale(1)';
        }
        if (zoomToggle) {
          zoomToggle.textContent = isZoomed ? '🔍 FIT SCREEN' : '🔍 150% ZOOM';
        }
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (zoomToggle) zoomToggle.addEventListener('click', toggleZoom);

      if (backdrop) {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop || e.target === wrapper) {
            closeModal();
          }
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
          closeModal();
        }
      });

      // Attach click-to-open handlers to all schematics, circuit diagrams, and gallery images
      function bindImages() {
        const images = document.querySelectorAll('img');
        images.forEach(img => {
          // Skip header/footer tiny logos
          if (img.width <= 40 && img.height <= 40) return;
          if (img.closest('.research-header') || img.closest('.editorial-footer')) return;
          
          img.style.cursor = 'zoom-in';
          img.title = img.title || 'Click to view screen-fit high-resolution';

          img.addEventListener('click', (e) => {
            e.stopPropagation();
            const altText = img.getAttribute('alt') || 'High-Resolution Diagram';
            const caption = img.getAttribute('data-caption') || altText;
            openModal(img.src, altText, caption);
          });
        });

        // Also bind any zoom hint buttons
        document.querySelectorAll('.zoom-hint-badge, .zoom-trigger-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const container = btn.closest('.screen-fit-container') || btn.closest('.bento-card');
            if (container) {
              const img = container.querySelector('img');
              if (img) {
                openModal(img.src, img.alt, img.alt);
              }
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindImages);
      } else {
        bindImages();
      }
    })();
  </script>
</body>
</html>
