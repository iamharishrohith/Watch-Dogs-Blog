---
import Layout from '../layouts/Layout.astro';

const circuitNodes = [
  {
    id: "system-bus",
    title: "Global System Bus & Signal Pathway",
    pill: "TOPOLOGY & PROTOCOL",
    badge: "GLOBAL SIGNAL PATH",
    img: "/circuit-diagrams/End-to-End - Signal Transmission.png",
    caption: "Figure 01: Global End-to-End Cyber-Physical Pathway — In-situ multi-hazard transducers (SPI / I2C / ADC) → Dual-Core ESP32-S3 firmware → 868 MHz LoRa mesh radio (+22dBm) → Base station gateway concentrator → Raspberry Pi 5 XGBoost 2.0 & Mohr-Coulomb physics engine → Sub-120ms optocoupled civil defense relay actuation.",
    active: true
  },
  {
    id: "node-1",
    title: "Node 1: Hillside Landslide Sentinel",
    pill: "GEOTECHNICAL NODE",
    badge: "DEEP-SEATED SLIP",
    img: "/circuit-diagrams/landslide node.png",
    caption: "Figure 02: Node 1 (Hillside Sentinel Schematic) — Complete geotechnical wiring schematic integrating dual-depth capacitive TDR soil moisture probes (ADC1 GPIO 34), MPU6050 6-DOF IMU (I2C GPIO 21/22), digital rain interrupt gauge (GPIO 13), BMP280 barometer (I2C 0x76), SSD1306 OLED display, and Semtech SX1278 LoRa radio (SPI).",
    active: false
  },
  {
    id: "node-2",
    title: "Node 2: Riverbed Flash Flood & Water Quality Sentinel",
    pill: "HYDROLOGY NODE",
    badge: "SURGE & SEDIMENT",
    img: "/circuit-diagrams/Node 2 - Flash Floods & Water Quality.png",
    caption: "Figure 03: Node 2 (Riverbed Sentinel Schematic) — Riparian hydrology node interfacing TS-300B optical turbidity sensor (ADC1 GPIO 34), HC-SR04 ultrasonic stage ranging (GPIO 27/14), DHT22 environmental transducer (GPIO 4), OLED display, and +22dBm LoRa transceiver on a regulated 3.3V / 5.0V dual rail.",
    active: false
  },
  {
    id: "node-3",
    title: "Node 3: Industrial Toxic Gas & Tremor Sentinel",
    pill: "HAZARDOUS ATMOSPHERE",
    badge: "TOXIC GAS & SEISMIC",
    img: "/circuit-diagrams/Industry and Gas Sentinel Node.png",
    caption: "Figure 04: Node 3 (Industrial Sentinel Schematic) — Hazardous environment node combining MQ-135 multi-gas sensing array (ADC1 GPIO 34), BMP280 atmospheric pressure transducer (I2C 0x76), piezoelectric tremor geophone, and Semtech SX1278 LoRa radio link.",
    active: false
  },
  {
    id: "node-4",
    title: "Node 4: Base Station Gateway & Siren Actuator",
    pill: "COORDINATION & ALERTS",
    badge: "CIVIL DEFENSE HUB",
    img: "/circuit-diagrams/Gateway Node.png",
    caption: "Figure 05: Node 4 (Base Station Gateway & Audio Actuator Schematic) — Master coordinator node equipped with high-gain 868 MHz LoRa transceiver, DFPlayer Mini voice module driving an 8Ω 3W loudspeaker for vernacular civil alerts, and synchronous UART/USB bridge to the central Raspberry Pi 5 compute engine.",
    active: false
  },
  {
    id: "power-tree",
    title: "Autonomous MPPT Power Tree & Battery Management",
    pill: "POWER HARVESTING",
    badge: "82.7-DAY AUTONOMY",
    img: "/circuit-diagrams/Power Distrubution part.png",
    caption: "Figure 06: MPPT Solar Energy Harvesting & Power Tree Schematic — 6V 5W Monocrystalline PV input → CN3791 MPPT charging controller → 3.2V 6000mAh Grade-A LiFePO4 battery → AP2112K low-dropout 3.3V regulator & MT3608 5.0V boost converter, delivering 82.7 days of continuous dark autonomy.",
    active: false
  }
];
---

<Layout title="WATCH-DOGS | Master Hardware Circuit Diagrams & Pinout Schematics" activeNav="circuits">
  <div class="container-wide" style="padding-top: 24px; padding-bottom: 60px;">

    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <div class="hero-pill" style="margin-bottom: 6px;">ELECTRICAL ENGINEERING &bull; HARDWARE SCHEMATICS</div>
        <h1 style="font-size: 2.2rem; font-weight: 900; margin: 0; letter-spacing: -0.02em;">
          Master Circuit Schematics &amp; Pinout Wire Connections
        </h1>
      </div>
      <div style="display: flex; gap: 8px;">
        <span class="card-badge badge-brand" style="padding: 6px 12px; font-weight: 800;">4 PHYSICAL NODES + GATEWAY</span>
        <span class="card-badge badge-safe" style="padding: 6px 12px; font-weight: 800;">VERIFIED PINOUT SAFE</span>
      </div>
    </div>

    <p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 880px; line-height: 1.5; margin-bottom: 24px;">
      Complete electrical wiring diagrams, sensor bus configurations (SPI, I2C, ADC, UART, PWM), power rails, and logic-level isolation across the physical WATCH-DOGS IoT mesh array. Click on any node below to inspect high-resolution schematics.
    </p>

    <!-- Bento Node Selector Grid -->
    <div class="bento-node-grid" id="circuit-tabs" style="margin-bottom: 28px;">
      <div class="bento-node-btn active" data-target="system-bus">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="M4 12h4l2-6 4 12 2-6h4"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">TOPOLOGY</span>
        </div>
        <div class="bento-node-btn-title">System Bus &amp; Signal</div>
        <div class="bento-node-btn-sub">Global GPIO &amp; RF Pathway</div>
      </div>

      <div class="bento-node-btn" data-target="node-1">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">NODE 01</span>
        </div>
        <div class="bento-node-btn-title">Hillside Sentinel</div>
        <div class="bento-node-btn-sub">Soil VWC &bull; MPU6050 &bull; Rain</div>
      </div>

      <div class="bento-node-btn" data-target="node-2">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-success);"><path d="M2 12c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0"/></svg>
          <span class="card-badge badge-safe" style="font-size: 0.65rem;">NODE 02</span>
        </div>
        <div class="bento-node-btn-title">Riverbed Surge</div>
        <div class="bento-node-btn-sub">Ultrasonic &bull; Laser ToF &bull; DHT</div>
      </div>

      <div class="bento-node-btn" data-target="node-3">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-warning);"><path d="M6 18h12M6 14h12M6 10h12M9 6h6"/></svg>
          <span class="card-badge badge-warning" style="font-size: 0.65rem;">NODE 03</span>
        </div>
        <div class="bento-node-btn-title">Industrial Gas &amp; Shock</div>
        <div class="bento-node-btn-sub">MQ-135 &bull; Seismic &bull; BMP280</div>
      </div>

      <div class="bento-node-btn" data-target="node-4">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="M4.93 19.07a10 10 0 0 1 0-14.14M7.76 16.24a6 6 0 0 1 0-8.48M12 12h.01"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">NODE 04</span>
        </div>
        <div class="bento-node-btn-title">Base Station Hub</div>
        <div class="bento-node-btn-sub">LoRa RX &bull; Audio &bull; RPi 5</div>
      </div>

      <div class="bento-node-btn" data-target="power-tree">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-success);"><rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 11v2"/></svg>
          <span class="card-badge badge-safe" style="font-size: 0.65rem;">POWER</span>
        </div>
        <div class="bento-node-btn-title">MPPT Power Tree</div>
        <div class="bento-node-btn-sub">CN3791 &bull; LiFePO4 &bull; 82.7-Day</div>
      </div>
    </div>

    <!-- Circuit Sections: Clean Screen-Fit Schematics + Minimal Caption Only -->
    {circuitNodes.map((node) => (
      <div class="circuit-section" id={`sec-${node.id}`} style={`display: ${node.active ? 'block' : 'none'};`}>
        <div class="bento-card col-12" style="border-top: 4px solid var(--accent-primary); padding: 0; overflow: hidden; background: #FFFFFF; margin-bottom: 24px;">
          
          <!-- Card Header -->
          <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div>
              <span class="card-badge badge-brand" style="font-size: 0.68rem; margin-bottom: 4px;">{node.pill}</span>
              <h2 style="font-size: 1.25rem; font-weight: 800; margin: 2px 0 0; color: var(--text-primary);">{node.title}</h2>
            </div>
            <span class="card-badge badge-safe">{node.badge}</span>
          </div>

          <!-- Screen-Fit Image Viewer -->
          <div class="screen-fit-container" style="margin: 0; border: none; border-radius: 0;">
            <div class="screen-fit-header" style="background: #0f172a; color: #FFFFFF; padding: 10px 16px;">
              <span style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 800; color: #93C5FD;">TECHNICAL SCHEMATIC &bull; HIGH RESOLUTION VIEW</span>
              <button 
                type="button" 
                class="screen-fit-inspect-btn image-lightbox-trigger" 
                data-lightbox-src={node.img} 
                data-lightbox-title={node.title} 
                data-lightbox-caption={node.caption}
                style="background: #1e293b; color: #FFFFFF; border: 1px solid #334155; font-size: 0.72rem; padding: 4px 10px; border-radius: 4px; cursor: pointer;"
              >
                EXPAND FULLSCREEN (HD)
              </button>
            </div>
            
            <div 
              class="screen-fit-image-wrapper image-lightbox-trigger" 
              data-lightbox-src={node.img} 
              data-lightbox-title={node.title} 
              data-lightbox-caption={node.caption} 
              style="min-height: 480px; max-height: 680px; height: auto; padding: 16px; background: #0b0f19; cursor: pointer; display: flex; align-items: center; justify-content: center;"
            >
              <img 
                src={node.img} 
                alt={node.title} 
                style="max-width: 100%; max-height: 650px; width: auto; height: auto; object-fit: contain;" 
              />
            </div>
          </div>

          <!-- Clean Minimal Caption Bar -->
          <div style="background: #F8FAFC; padding: 16px 20px; border-top: 1px solid var(--border-subtle); display: flex; align-items: flex-start; gap: 12px;">
            <div style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 800; color: var(--accent-primary); background: #EFF6FF; border: 1px solid #BFDBFE; padding: 3px 8px; border-radius: 4px; flex-shrink: 0; margin-top: 1px;">
              CAPTION
            </div>
            <p style="font-size: 0.85rem; color: var(--text-primary); line-height: 1.5; margin: 0;">
              {node.caption}
            </p>
          </div>

        </div>
      </div>
    ))}

  </div>

  <!-- Client-Side Tab Switcher Script -->
  <script is:inline>
    const tabs = document.querySelectorAll('#circuit-tabs .bento-node-btn');
    const sections = document.querySelectorAll('.circuit-section');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const targetId = 'sec-' + tab.getAttribute('data-target');
        sections.forEach(sec => {
          if (sec.id === targetId) {
            sec.style.display = 'block';
          } else {
            sec.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
