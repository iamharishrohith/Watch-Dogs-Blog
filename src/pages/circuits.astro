---
import Layout from '../layouts/Layout.astro';
---

<Layout title="WATCH-DOGS | Master Hardware Circuit Diagrams & Pinout Schematics" activeNav="circuits">
  <div class="container-wide" style="padding-top: 24px; padding-bottom: 60px;">

    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
      <div>
        <div class="hero-pill" style="margin-bottom: 6px;">ELECTRICAL ENGINEERING &bull; HARDWARE SCHEMATICS</div>
        <h1 style="font-size: 2.3rem; font-weight: 900; margin: 0; letter-spacing: -0.02em;">
          Master Circuit Schematics &amp; Pinout Wire Connections
        </h1>
      </div>
      <div style="display: flex; gap: 8px;">
        <span class="card-badge badge-brand" style="padding: 6px 12px; font-weight: 800;">4 PHYSICAL NODES + GATEWAY</span>
        <span class="card-badge badge-safe" style="padding: 6px 12px; font-weight: 800;">VERIFIED PINOUT SAFE (&le; 34)</span>
      </div>
    </div>

    <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 920px; line-height: 1.6; margin-bottom: 32px;">
      Complete electrical wiring diagrams, sensor bus configurations (SPI, I2C, ADC, UART, PWM), power rails, and logic-level isolation across the physical WATCH-DOGS IoT mesh array.
    </p>

    <!-- Interactive Bento Node Selector Grid -->
    <div class="bento-node-grid" id="circuit-tabs">
      <div class="bento-node-btn active" data-target="system-bus">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="M4 12h4l2-6 4 12 2-6h4"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">TOPOLOGY</span>
        </div>
        <div class="bento-node-btn-title">System Bus &amp; Signal</div>
        <div class="bento-node-btn-sub">Global GPIO &amp; RF Pathway</div>
      </div>

      <div class="bento-node-btn" data-target="node-1">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">NODE 01</span>
        </div>
        <div class="bento-node-btn-title">Hillside Sentinel</div>
        <div class="bento-node-btn-sub">Soil VWC &bull; MPU6050 &bull; Rain</div>
      </div>

      <div class="bento-node-btn" data-target="node-2">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-success);"><path d="M2 12c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0"/></svg>
          <span class="card-badge badge-safe" style="font-size: 0.65rem;">NODE 02</span>
        </div>
        <div class="bento-node-btn-title">Riverbed Surge</div>
        <div class="bento-node-btn-sub">Ultrasonic &bull; Laser ToF &bull; DHT</div>
      </div>

      <div class="bento-node-btn" data-target="node-3">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-warning);"><path d="M6 18h12M6 14h12M6 10h12M9 6h6"/></svg>
          <span class="card-badge badge-warning" style="font-size: 0.65rem;">NODE 03</span>
        </div>
        <div class="bento-node-btn-title">Industrial Gas &amp; Shock</div>
        <div class="bento-node-btn-sub">MQ-135 &bull; Seismic &bull; BMP280</div>
      </div>

      <div class="bento-node-btn" data-target="node-4">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-primary);"><path d="M4.93 19.07a10 10 0 0 1 0-14.14M7.76 16.24a6 6 0 0 1 0-8.48M12 12h.01"/></svg>
          <span class="card-badge badge-brand" style="font-size: 0.65rem;">NODE 04</span>
        </div>
        <div class="bento-node-btn-title">Base Station Hub</div>
        <div class="bento-node-btn-sub">LoRa RX &bull; Audio &bull; RPi 5</div>
      </div>

      <div class="bento-node-btn" data-target="power-tree">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-success);"><rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 11v2"/></svg>
          <span class="card-badge badge-safe" style="font-size: 0.65rem;">POWER</span>
        </div>
        <div class="bento-node-btn-title">MPPT Power Tree</div>
        <div class="bento-node-btn-sub">CN3791 &bull; LiFePO4 &bull; 82.7-Day</div>
      </div>
    </div>

    <!-- ============================================================
         SECTION 0: MASTER SYSTEM BUS ARCHITECTURE
         ============================================================ -->
    <div class="circuit-section active" id="sec-system-bus">
      <div class="bento-card col-12" style="border-top: 4px solid var(--accent-primary); margin-bottom: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <div>
            <span class="card-badge badge-brand">GLOBAL BUS OVERVIEW</span>
            <h2 style="font-size: 1.4rem; font-weight: 800; margin: 4px 0;">ESP32-S3 Global GPIO Allocation &amp; Bus Topology</h2>
          </div>
          <span class="status-badge">ZERO PIN CONFLICT VERIFIED</span>
        </div>

        <!-- Visual End-to-End Signal Architecture Schematic -->
        <div class="screen-fit-container">
          <div class="screen-fit-header">
            <div>
              <span>SYSTEM ARCHITECTURE &bull; END-TO-END SIGNAL TRANSMISSION &amp; ACTUATION PATHWAY</span>
            </div>
            <button type="button" class="zoom-hint-badge" title="Click to open screen-fit inspection mode">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              INSPECT HD SCHEMATIC
            </button>
          </div>
          <img 
            src="/circuit-diagrams/End-to-End - Signal Transmission.png" 
            alt="End-to-End Signal Transmission and Actuation Pathway Diagram" 
            data-caption="End-to-End Cyber-Physical Pipeline: Sensor Node &rarr; SX1278 LoRa &rarr; Gateway Concentrator &rarr; Raspberry Pi 5 AI &rarr; Physical Actuators"
            class="screen-fit-img" 
          />
        </div>

        <!-- Master Bus Diagram SVG -->
        <div style="background: #0B0F19; border: 1px solid #1F2937; border-radius: 8px; padding: 24px; overflow-x: auto; margin-bottom: 20px;">
          <svg width="100%" height="340" viewBox="0 0 1000 340" style="min-width: 800px; display: block;">
            <!-- Background grid -->
            <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1E293B" stroke-width="0.5"/>
            </pattern>
            <rect width="1000" height="340" fill="url(#grid)" />

            <!-- ESP32 Core Box -->
            <rect x="380" y="40" width="240" height="260" rx="10" fill="#1E1E2F" stroke="#6366F1" stroke-width="2.5" />
            <text x="500" y="75" fill="#FFFFFF" font-family="'JetBrains Mono', monospace" font-size="14" font-weight="bold" text-anchor="middle">ESP32-WROOM-32 / S3</text>
            <text x="500" y="95" fill="#A5B4FC" font-family="'JetBrains Mono', monospace" font-size="10" text-anchor="middle">Dual-Core 240MHz &bull; 3.3V Logic</text>

            <!-- SPI Bus Block (Left Top) -->
            <rect x="40" y="40" width="220" height="80" rx="6" fill="#111827" stroke="#3B82F6" stroke-width="1.5" />
            <text x="150" y="65" fill="#60A5FA" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" text-anchor="middle">LoRa SX1278 (SPI Bus)</text>
            <text x="150" y="85" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">SCK: 18 | MISO: 19 | MOSI: 23</text>
            <text x="150" y="102" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">NSS: 5 | RST: 16 | DIO0: 26/2/33</text>
            <!-- Wire Line -->
            <path d="M 260 80 L 380 80" stroke="#3B82F6" stroke-width="2" stroke-dasharray="4,4" />

            <!-- I2C Bus Block (Left Bottom) -->
            <rect x="40" y="160" width="220" height="120" rx="6" fill="#111827" stroke="#10B981" stroke-width="1.5" />
            <text x="150" y="185" fill="#34D399" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" text-anchor="middle">I2C Sensor Bus (400kHz)</text>
            <text x="150" y="205" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">SDA: GPIO 21 | SCL: GPIO 22</text>
            <text x="150" y="225" fill="#CBD5E1" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">&bull; SSD1306/SH1106 OLED (0x3C)</text>
            <text x="150" y="243" fill="#CBD5E1" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">&bull; BMP280 Baro/Temp (0x76)</text>
            <text x="150" y="261" fill="#CBD5E1" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">&bull; MPU6050 6-DOF IMU (0x68)</text>
            <!-- Wire Line -->
            <path d="M 260 220 L 380 220" stroke="#10B981" stroke-width="2" />

            <!-- Analog ADC1 Block (Right Top) -->
            <rect x="740" y="40" width="220" height="95" rx="6" fill="#111827" stroke="#F59E0B" stroke-width="1.5" />
            <text x="850" y="65" fill="#FBBF24" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" text-anchor="middle">Analog ADC1 Inputs (Safe)</text>
            <text x="850" y="85" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 34: Soil VWC / MQ135 / Rain</text>
            <text x="850" y="103" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 32: LDR Lux / Rain Level</text>
            <text x="850" y="120" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">12-Bit Resolution (0 - 4095)</text>
            <!-- Wire Line -->
            <path d="M 740 85 L 620 85" stroke="#F59E0B" stroke-width="2" />

            <!-- Hardware Actuation & Digital I/O (Right Bottom) -->
            <rect x="740" y="170" width="220" height="110" rx="6" fill="#111827" stroke="#EF4444" stroke-width="1.5" />
            <text x="850" y="195" fill="#F87171" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="bold" text-anchor="middle">Actuators &amp; Digital I/O</text>
            <text x="850" y="215" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 26/27: DFPlayer Mini Audio</text>
            <text x="850" y="233" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 27/14: Ultrasonic Trig/Echo</text>
            <text x="850" y="251" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 13: Digital Rain Interrupt</text>
            <text x="850" y="269" fill="#9CA3AF" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">GPIO 4: DHT22 1-Wire Data</text>
            <!-- Wire Line -->
            <path d="M 740 225 L 620 225" stroke="#EF4444" stroke-width="2" />
          </svg>
        </div>

        <!-- System Bus Specs Matrix Table -->
        <table class="matrix-table" style="margin-top: 10px;">
          <thead>
            <tr>
              <th>Bus / Protocol</th>
              <th>Pins (ESP32)</th>
              <th>Connected Sensors &amp; Peripherals</th>
              <th>Voltage Rail</th>
              <th>Signal Characteristics</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Hardware SPI</strong></td>
              <td><code>SCK: 18, MISO: 19, MOSI: 23, NSS: 5, RST: 16</code></td>
              <td>Semtech SX1278 / SX1262 LoRa Transceiver (+22 dBm)</td>
              <td>3.3V Regulated</td>
              <td>10 MHz Max SPI Clock, Hardware DMA buffered</td>
            </tr>
            <tr>
              <td><strong>Hardware I2C</strong></td>
              <td><code>SDA: GPIO 21, SCL: GPIO 22</code></td>
              <td>SSD1306/SH1106 OLED (0x3C), BMP280 Barometer (0x76), MPU6050 6-DOF IMU (0x68), VL53L0X Laser (0x29)</td>
              <td>3.3V Regulated</td>
              <td>400 kHz Fast-Mode I2C Bus, 4.7k&Omega; pullups to 3.3V</td>
            </tr>
            <tr>
              <td><strong>Analog ADC1</strong></td>
              <td><code>GPIO 34 (ADC1_CH6), GPIO 32 (ADC1_CH4)</code></td>
              <td>Capacitive Soil Moisture Probe, MQ-135 Gas Sensor, Rain Sensor ADC, LDR Photoresistor</td>
              <td>3.3V Max (Input)</td>
              <td>12-bit SAR ADC, 0–3.3V attenuation (11dB), zero Wi-Fi conflict</td>
            </tr>
            <tr>
              <td><strong>Hardware UART1</strong></td>
              <td><code>TX1: GPIO 27, RX1: GPIO 26</code></td>
              <td>DFPlayer Mini MP3 Sound Module (Vernacular Civil Defense Voice)</td>
              <td>5.0V / 3.3V</td>
              <td>9600 Baud 8N1 Async Serial, driving 8&Omega; 3W speaker</td>
            </tr>
            <tr>
              <td><strong>Digital GPIO / PWM</strong></td>
              <td><code>TRIG: 27, ECHO: 14, DHT: 4, RAIN_D: 13, IR: 25</code></td>
              <td>HC-SR04 Ultrasonic Ranging, DHT22 Temp/Humidity, Rain Comparator Digital Trip, IR Beam</td>
              <td>3.3V / 5.0V</td>
              <td>Direct hardware timer interrupts, wake-on-pin edge</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============================================================
         SECTION 1: NODE 1 (HILLSIDE GENESIS SENTINEL)
         ============================================================ -->
    <div class="circuit-section" id="sec-node-1" style="display: none;">
      <div class="bento-card col-12" style="border-top: 4px solid #3B82F6; margin-bottom: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <div>
            <span class="card-badge badge-brand">NODE 1 SCHEMATIC</span>
            <h2 style="font-size: 1.4rem; font-weight: 800; margin: 4px 0;">Node 1: Hillside Landslide &amp; Geotechnical Sentinel</h2>
            <p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0;">Target Hazards: Deep-Seated Landslide, Headscarp Shear Fracture, Soil Moisture Infiltration, Rainfall Rate</p>
          </div>
          <span class="card-badge badge-safe">FIRMWARE: node1_hillside.ino</span>
        </div>

        <!-- Visual Schematic Diagram Image (Screen-Fit with Fullscreen Zoom) -->
        <div class="screen-fit-container">
          <div class="screen-fit-header">
            <div>
              <span>PHYSICAL SCHEMATIC &bull; LANDSLIDE SENTINEL NODE 1</span>
            </div>
            <button type="button" class="zoom-hint-badge" title="Click to open screen-fit inspection mode">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              INSPECT HD SCHEMATIC
            </button>
          </div>
          <img 
            src="/circuit-diagrams/landslide node.png" 
            alt="Landslide Sentinel Node 1 Complete Electrical Circuit Diagram" 
            data-caption="Node 1: Hillside Landslide Sentinel — Complete ESP32 + LoRa + MPU6050 + TDR Soil Sensor Wiring Schematic"
            class="screen-fit-img" 
          />
        </div>

        <!-- Node 1 Circuit Pinout Card -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          
          <!-- Detailed Pin Connections Table -->
          <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 18px;">
            <h4 style="font-size: 0.95rem; font-weight: 800; margin-bottom: 12px; color: var(--accent-primary);">Hardware Pinout Table</h4>
            <table style="width: 100%; font-family: var(--font-mono); font-size: 0.78rem; border-collapse: collapse;">
              <thead>
                <tr style="border-bottom: 1px solid #CBD5E1; color: var(--text-secondary);">
                  <th style="text-align: left; padding: 6px 0;">Module</th>
                  <th style="text-align: left; padding: 6px 0;">Sensor Pin</th>
                  <th style="text-align: left; padding: 6px 0;">ESP32 GPIO</th>
                  <th style="text-align: left; padding: 6px 0;">Power</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>SX1278 LoRa</strong></td>
                  <td>SCK, MISO, MOSI, NSS, RST, DIO0</td>
                  <td><code>18, 19, 23, 5, 16, 26</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>SSD1306 OLED</strong></td>
                  <td>SDA, SCL</td>
                  <td><code>GPIO 21, GPIO 22</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>BMP280 Baro</strong></td>
                  <td>SDA, SCL (Address: 0x76)</td>
                  <td><code>GPIO 21, GPIO 22</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>MPU6050 IMU</strong></td>
                  <td>SDA, SCL (Address: 0x68)</td>
                  <td><code>GPIO 21, GPIO 22</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>TDR Soil Sensor</strong></td>
                  <td>Analog AOUT</td>
                  <td><code>GPIO 34 (ADC1_CH6)</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr style="border-bottom: 1px solid #E2E8F0;">
                  <td><strong>Rain Plate Sensor</strong></td>
                  <td>Analog AOUT / Digital DOUT</td>
                  <td><code>GPIO 32 (AOUT), GPIO 13 (DOUT)</code></td>
                  <td>3.3V / GND</td>
                </tr>
                <tr>
                  <td><strong>IR Tilt Barrier</strong></td>
                  <td>Digital OUT</td>
                  <td><code>GPIO 25 (Digital IN)</code></td>
                  <td>3.3V / GND</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Functional Circuit Flowchart -->
          <div style="background: #0B0F19; border: 1px solid #1F2937; border-radius: 8px; padding: 20px; color: #E5E7EB; font-family: var(--font-mono); font-size: 0.78rem;">
            <div style="color: #60A5FA; font-weight: 800; margin-bottom: 10px;">CIRCUIT SIGNAL FLOW</div>
            <div style="line-height: 1.8;">
              <div style="color: #FBBF24;">[SOIL VWC PROBE 1.5m] ──(Analog mV)──&gt; GPIO 34 (12-bit ADC)</div>
              <div style="color: #38BDF8;">[MPU6050 6-DOF TILT] ──(I2C 0x68)───&gt; GPIO 21/22 (Pitch &amp; Roll)</div>
              <div style="color: #34D399;">[BMP280 BAROMETER]   ──(I2C 0x76)───&gt; GPIO 21/22 (hPa &amp; Temp)</div>
              <div style="color: #F87171;">[RAIN DROP DETECTOR] ──(Digital DO)──&gt; GPIO 13 (Wake ISR)</div>
              <div style="margin: 10px 0; border-top: 1px dashed #374151;"></div>
              <div style="color: #A78BFA;">&gt;&gt; FreeRTOS Task: Bayesian Sensor Sampling &amp; JSON Packing</div>
              <div style="color: #3B82F6;">&gt;&gt; LoRa.beginPacket() ──(SPI 18/19/23/5)──&gt; SX1278 Antenna (+22dBm)</div>
              <div style="color: #10B981;">&gt;&gt; SSD1306 Display ──(I2C 0x3C)──&gt; Live Status &amp; Tilt Angles</div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ============================================================
         SECTION 2: NODE 2 (RIVERBED SURGE SENTINEL)
         ============================================================ -->
    <div class="circuit-section" id="sec-node-2" style="display: none;">
      <div class="bento-card col-12" style="border-top: 4px solid #10B981; margin-bottom: 28px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <div>
            <span class="card-badge badge-safe">NODE 2 SCHEMATIC</span>
            <h2 style="font-size: 1.4rem; font-weight: 800; margin: 4px 0;">Node 2: Riverbed &amp; Canopy Flash Flood Sentinel</h2>
            <p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0;">Target Hazards: River Surge Wave, Glacial Lake Outburst (GLOF), Forest Canopy Fire Index, Flash Flood</p>
          </div>
          <span class="card-badge badge-safe">FIRMWARE: node2_riverbed.ino</span>
        </div>

        <!-- Visual Schematic Diagram Image (Screen-Fit with Fullscreen Zoom) -->
        <div class="screen-fit-container">
          <div class="screen-fit-header">
            <div>
              <span>PHYSICAL SCHEMATIC &bull; RIVERBED &amp; FLASH FLOOD SENTINEL NODE 2</span>
            </div>
            <button type="button" class="zoom-hint-badge" title="Click to open screen-fit inspection mode">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              INSPECT HD SCHEMATIC
            </button>
          </div>
          <img 
            src="/circuit-diagrams/Node 2 - Flash Floods & Water Quality.png" 
            alt="Node 2 Flash Flood and Water Quality Sentinel Circuit Diagram" 
            data-caption="Node 2: Riverbed Stage &amp; Water Quality Sentinel — Dual Ultrasonic HC-SR04 + Laser ToF VL53L0X + Turbidity + DHT22 Wiring Schematic"
            class="screen-fit-img" 
          />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          
          <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 18px;">
            <h4 style="font-size: 0.95rem; font-weight: 800; margin-bottom: 12px; color: var(--accent-success);">Dual-Redundant Ranging Pin Map</h4>
            <table style="width: 100%; font-family: var(--font-mono); font-size: 0.78rem; border-collapse: collapse;">
              <thead>
