---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="WATCH-DOGS — Project Resources Index" 
  description="Compact engineering and research resource index for WATCH-DOGS: Source code, research portal, 3D digital twin, circuit schematics, and physical demonstration."
  activeNav="links"
  hideHeader={true}
  hideFooter={true}
>
  <div class="resource-index-wrapper">
    
    <!-- Top Compact Header & Brand -->
    <div class="index-container">
      
      <header class="index-header">
        <div class="header-top-row">
          <div class="brand-cluster">
            <img src="/logos/Monarchs Logo.png" alt="Team Monarchs" class="brand-icon" />
            <span class="brand-divider">/</span>
            <img src="/logos/watchdogs_logo.jpg" alt="WATCH-DOGS" class="brand-icon round" />
            <span class="team-label">TEAM MONARCHS</span>
          </div>

          <div class="header-status-strip">
            <span class="status-item"><span class="status-dot"></span> AIR-GAPPED</span>
            <span class="status-item">868 MHz MESH</span>
            <span class="status-item">BSA 2023 §65B</span>
            <span class="status-item">&lt;120ms TRIP</span>
          </div>
        </div>

        <div class="header-content">
          <div class="section-label">PROJECT RESOURCES</div>
          <h1 class="main-heading">Everything behind WATCH-DOGS, from source code to physical validation.</h1>
          <p class="acronym-note">
            <strong>WATCH-DOGS:</strong> Wireless Autonomous Telemetry, Critical Hazard Detection &amp; Optocoupled Ground System
          </p>
        </div>
      </header>

      <!-- 5-Row Vertical Technical Resource Index -->
      <main class="resource-list" role="list">
        
        <!-- Row 01: Core Engineering Repository -->
        <a href="https://github.com/iamharishrohith/WATCH-DOGS" target="_blank" rel="noopener noreferrer" class="resource-row" role="listitem">
          <div class="row-num-col">
            <span class="row-num">01</span>
            <span class="row-category">SOURCE</span>
          </div>
          <div class="row-body-col">
            <div class="row-title-line">
              <h2 class="resource-title">CORE ENGINEERING REPOSITORY</h2>
              <span class="resource-url">github.com/iamharishrohith/WATCH-DOGS</span>
            </div>
            <p class="resource-desc">Firmware &bull; Edge AI Engine &bull; Datasets &bull; Hardware BOM</p>
          </div>
          <div class="row-action-col">
            <span class="action-btn">
              <span>OPEN</span>
              <span class="action-arrow">&nearr;</span>
            </span>
          </div>
        </a>

        <!-- Row 02: Research & Documentation Portal -->
        <a href="/" class="resource-row" role="listitem">
          <div class="row-num-col">
            <span class="row-num">02</span>
            <span class="row-category">RESEARCH</span>
          </div>
          <div class="row-body-col">
            <div class="row-title-line">
              <h2 class="resource-title">RESEARCH &amp; DOCUMENTATION PORTAL</h2>
              <span class="resource-url">watch-dogs-research.vercel.app</span>
            </div>
            <p class="resource-desc">Empirical audits &bull; Geomechanical physics &bull; PINN specifications</p>
          </div>
          <div class="row-action-col">
            <span class="action-btn">
              <span>OPEN</span>
              <span class="action-arrow">&nearr;</span>
            </span>
          </div>
        </a>

        <!-- Row 03: Geospatial 3D Digital Twin -->
        <a href="https://watch-dogs-3d.vercel.app/" target="_blank" rel="noopener noreferrer" class="resource-row" role="listitem">
          <div class="row-num-col">
            <span class="row-num">03</span>
            <span class="row-category">SIMULATION</span>
          </div>
          <div class="row-body-col">
            <div class="row-title-line">
              <h2 class="resource-title">GEOSPATIAL 3D DIGITAL TWIN</h2>
              <span class="resource-url">watch-dogs-3d.vercel.app</span>
            </div>
            <p class="resource-desc">WebGL terrain &bull; Live LoRa telemetry &bull; Evacuation routing</p>
          </div>
          <div class="row-action-col">
            <span class="action-btn">
              <span>OPEN</span>
              <span class="action-arrow">&nearr;</span>
            </span>
          </div>
        </a>

        <!-- Row 04: Circuit Schematics & Pinouts -->
        <a href="/circuits" class="resource-row" role="listitem">
          <div class="row-num-col">
            <span class="row-num">04</span>
            <span class="row-category">SCHEMATICS</span>
          </div>
          <div class="row-body-col">
            <div class="row-title-line">
              <h2 class="resource-title">CIRCUIT SCHEMATICS &amp; PINOUT</h2>
              <span class="resource-url">watch-dogs-research.vercel.app/circuits</span>
            </div>
            <p class="resource-desc">HD board schematics &bull; Decoupling &bull; Optocoupler relay design</p>
          </div>
          <div class="row-action-col">
            <span class="action-btn">
              <span>OPEN</span>
              <span class="action-arrow">&nearr;</span>
            </span>
          </div>
        </a>

        <!-- Row 05: Physical Hardware Video Demo -->
        <a href="https://youtu.be/watch-dogs-demo" target="_blank" rel="noopener noreferrer" class="resource-row" role="listitem">
          <div class="row-num-col">
            <span class="row-num">05</span>
            <span class="row-category">DEMO</span>
          </div>
          <div class="row-body-col">
            <div class="row-title-line">
              <h2 class="resource-title">PHYSICAL TESTBED DEMONSTRATION</h2>
              <span class="resource-url">youtu.be/watch-dogs-demo</span>
            </div>
            <p class="resource-desc">4-node mesh &bull; Flume infiltration &bull; 130 dB siren trip</p>
          </div>
          <div class="row-action-col">
            <span class="action-btn">
              <span>WATCH</span>
              <span class="action-arrow">&nearr;</span>
            </span>
          </div>
        </a>

      </main>

      <!-- Bottom Research Credentials Rail -->
      <footer class="index-footer">
        <div class="footer-left">
          <span class="footer-team">TEAM MONARCHS</span>
          <span class="footer-sep">&bull;</span>
          <span>Mentor: <strong>Dr. K Arun Kumar</strong>, Ph.D. <span class="footer-mentor-note">(17 Yrs Cloud Tech &amp; Brain Computer Interface)</span></span>
          <span class="footer-sep">&bull;</span>
          <span>Lead: <strong>Harish Rohith S</strong></span>
        </div>
        <div class="footer-right">
          <a href="/architecture" class="subsystem-link">Architecture</a>
          <span class="footer-sep">&bull;</span>
          <a href="/intelligence" class="subsystem-link">PINN Engine</a>
          <span class="footer-sep">&bull;</span>
          <a href="/about" class="subsystem-link">About Lab</a>
        </div>
      </footer>

    </div>
  </div>
</Layout>

<style>
  /* ── Resource Index Container (Centered, Max Width, Clean) ── */
  .resource-index-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #FFFFFF;
    padding: 32px 24px;
    box-sizing: border-box;
  }

  .index-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  /* ── Header Area ── */
  .index-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #E2E8F0;
  }

  .header-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .brand-cluster {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .brand-icon.round {
    border-radius: 4px;
    object-fit: cover;
  }

  .brand-divider {
    color: #CBD5E1;
    font-weight: 300;
  }

  .team-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: 0.08em;
  }

  .header-status-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .status-item {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #475569;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.02em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    color: #2563EB;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .main-heading {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .acronym-note {
    font-size: 0.82rem;
    color: #64748B;
    margin: 4px 0 0;
    line-height: 1.4;
  }
  .acronym-note strong {
    color: #334155;
  }

  /* ── 5-Row Vertical Resource List ── */
  .resource-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .resource-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 16px 24px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    min-height: 80px;
    box-sizing: border-box;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .resource-row:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
  }

  .resource-row:hover .action-btn {
    color: #1D4ED8;
  }

  .resource-row:hover .action-arrow {
    transform: translate(3px, -2px);
  }

  /* Left Number & Micro Category */
  .row-num-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    width: 68px;
    flex-shrink: 0;
  }

  .row-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    color: #0F172A;
    line-height: 1;
  }

  .row-category {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 800;
    color: #64748B;
    background: #F1F5F9;
    padding: 2px 4px;
    border-radius: 3px;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  /* Center Body */
  .row-body-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .row-title-line {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .resource-title {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .resource-url {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #64748B;
  }

  .resource-desc {
    font-size: 13.5px;
    color: #475569;
    margin: 0;
    line-height: 1.4;
  }

  /* Right Action */
  .row-action-col {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: #2563EB;
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }

  .action-arrow {
    font-size: 14px;
    transition: transform 0.15s ease;
    display: inline-block;
  }

  /* ── Bottom Rail ── */
  .index-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid #E2E8F0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #64748B;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-team {
    font-weight: 800;
    color: #0F172A;
  }

  .footer-mentor-note {
    color: #94A3B8;
  }

  .footer-sep {
    color: #CBD5E1;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subsystem-link {
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .subsystem-link:hover {
    color: #2563EB;
    text-decoration: underline;
  }

  /* ── Responsive Behavior ── */
  @media (max-width: 860px) {
    .resource-index-wrapper {
      padding: 20px 16px;
      height: auto;
      min-height: 100vh;
    }

    .main-heading {
      font-size: 1.25rem;
    }

    .resource-row {
      padding: 14px 18px;
      gap: 14px;
      min-height: auto;
    }

    .resource-title {
      font-size: 16px;
    }

    .row-num-col {
      width: 50px;
    }
  }

  @media (max-width: 640px) {
    .header-top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .resource-row {
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 16px;
      gap: 10px;
    }

    .row-num-col {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      width: auto;
    }

    .row-title-line {
      flex-direction: column;
      gap: 2px;
    }

    .row-action-col {
      width: 100%;
      justify-content: flex-end;
      padding-top: 6px;
      border-top: 1px dashed #F1F5F9;
    }

    .index-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
