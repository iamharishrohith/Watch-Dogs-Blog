---
import Layout from '../layouts/Layout.astro';

const primaryLinks = [
  {
    id: "01",
    title: "Core Engineering Repository",
    tag: "GITHUB REPOSITORY",
    badgeType: "badge-brand",
    url: "https://github.com/iamharishrohith/WATCH-DOGS",
    displayUrl: "github.com/iamharishrohith/WATCH-DOGS",
    desc: "Complete ESP32-S3 C/C++ firmware, Raspberry Pi 5 edge server, PyTorch PINN models, calibrated datasets & hardware BOM.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`
  },
  {
    id: "02",
    title: "Research & Documentation Portal",
    tag: "LIVE WEB PORTAL",
    badgeType: "badge-safe",
    url: "https://watch-dogs-research.vercel.app/",
    displayUrl: "watch-dogs-research.vercel.app",
    desc: "Interactive technical dossier, 10-year empirical forensic disaster audits, geomechanical formulas & legal compliance ledger.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`
  },
  {
    id: "03",
    title: "Geospatial 3D Digital Twin",
    tag: "WEBGL 3D SIMULATOR",
    badgeType: "badge-brand",
    url: "https://watch-dogs-3d.vercel.app/",
    displayUrl: "watch-dogs-3d.vercel.app",
    desc: "Interactive 3D elevation terrain, real-time node telemetry visualization, dynamic flood surges & AI evacuation path routing.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.12 6.4-6.05-4.06a2 2 0 0 0-2.17-.05L2.95 8.41a2 2 0 0 0-.95 1.7v5.78a2 2 0 0 0 .96 1.71l10 5.71a2 2 0 0 0 1.98 0l6.18-3.53a2 2 0 0 0 1-1.74V8.14a2 2 0 0 0-1.02-1.74z"/><path d="m3.27 6.96 9.73 5.55 9.73-5.55"/><path d="M12 22.08V12.51"/></svg>`
  },
  {
    id: "04",
    title: "Circuit Schematics & Pinout Branch",
    tag: "FULL HD SCHEMATICS",
    badgeType: "badge-safe",
    url: "https://watch-dogs-research.vercel.app/circuits",
    displayUrl: "watch-dogs-research.vercel.app/circuits",
    desc: "Board schematics for all 4 sentinel nodes, power distribution circuits, LC decoupling filters & optocoupler solid-state relays.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>`
  },
  {
    id: "05",
    title: "Physical Testbed Demonstration Video",
    tag: "YOUTUBE VIDEO PROOF",
    badgeType: "badge-danger",
    url: "https://youtu.be/watch-dogs-demo",
    displayUrl: "youtu.be/watch-dogs-demo",
    desc: "Video proof of 4-node physical mesh synchronization, flume soil saturation, optical turbidity detection & 130dB siren trip.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m10 15 5-3-5-3v6Z"/><rect width="20" height="14" x="2" y="5" rx="2"/></svg>`
  }
];

const subSections = [
  { title: "4-Layer Architecture", href: "/architecture", badge: "SYSTEMS" },
  { title: "PINN Physics-AI Core", href: "/intelligence", badge: "AI ENGINE" },
  { title: "868 MHz LoRa Mesh", href: "/communication", badge: "WIRELESS" },
  { title: "Hardware BOM & Sensors", href: "/hardware", badge: "SILICON" },
  { title: "10-Year Case Studies", href: "/research", badge: "FORENSICS" },
  { title: "Team Monarchs Profile", href: "/about", badge: "TEAM" }
];
---

<Layout title="WATCH-DOGS Unified Gateway — Single Project Hub" activeNav="">
  <div class="container" style="max-width: 820px; padding-top: 36px; padding-bottom: 60px;">

    <!-- Central Branding Card -->
    <div class="bento-card col-12" style="text-align: center; padding: 36px 24px; background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%); border: 1.5px solid var(--border-medium); margin-bottom: 28px; box-shadow: 0 10px 30px rgba(0,0,0,0.04);">
      
      <!-- Dual Logo Header -->
      <div style="display: flex; justify-content: center; align-items: center; gap: 16px; margin-bottom: 18px;">
        <div style="background: #FFFFFF; border: 1.5px solid var(--border-medium); border-radius: 8px; padding: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          <img src="/logos/Monarchs Logo.png" alt="Team Monarchs Logo" style="width: 52px; height: 52px; object-fit: contain;" />
        </div>
        <div style="background: #FFFFFF; border: 1.5px solid var(--border-medium); border-radius: 8px; padding: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          <img src="/logos/watchdogs_logo.jpg" alt="WATCH-DOGS Logo" style="width: 52px; height: 52px; object-fit: cover; border-radius: 4px;" />
        </div>
      </div>

      <div style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.76rem; font-weight: 800; color: var(--accent-primary); background: #EFF6FF; border: 1px solid #BFDBFE; padding: 4px 12px; border-radius: 100px; margin-bottom: 12px;">
        <span class="pulse-dot" style="background: var(--accent-primary);"></span>
        <span>TEAM MONARCHS &bull; UNIFIED PROJECT GATEWAY</span>
      </div>

      <h1 style="font-size: 2.2rem; font-weight: 900; letter-spacing: -0.02em; margin: 0 0 8px; color: var(--text-primary);">
        WATCH-DOGS
      </h1>

      <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 800; color: var(--accent-primary); max-width: 600px; margin: 0 auto 14px; line-height: 1.4;">
        Wireless Autonomous Telemetry, Critical Hazard Detection &amp; Optocoupled Ground System
      </div>

      <p style="font-size: 0.90rem; color: var(--text-secondary); max-width: 620px; margin: 0 auto; line-height: 1.55;">
        Air-Gapped, Zero-Cloud Multi-Hazard Early Warning Mesh Appliance with Physics-Informed Neural Networks (PINN) and Sub-120ms Civil Defense Relay Actuation.
      </p>

      <div style="display: flex; justify-content: center; gap: 8px; margin-top: 18px; flex-wrap: wrap;">
        <span class="card-badge badge-brand" style="padding: 4px 10px; font-weight: 800;">0% CLOUD DEPENDENCY</span>
        <span class="card-badge badge-safe" style="padding: 4px 10px; font-weight: 800;">868 MHz LORA MESH</span>
        <span class="card-badge badge-brand" style="padding: 4px 10px; font-weight: 800;">BSA 2023 / SEC 65B LEDGER</span>
      </div>
    </div>

    <!-- Section Heading -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 4px;">
      <span style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 800; color: var(--text-primary); text-transform: uppercase;">
        Official Project Artifacts &amp; Live Platforms
      </span>
      <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-primary); font-weight: 700;">
        5 VERIFIED ENDPOINTS
      </span>
    </div>

    <!-- 5 Primary Link Action Cards -->
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px;">
      {primaryLinks.map(link => (
        <a 
          href={link.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bento-card col-12"
          style="display: flex; gap: 16px; align-items: center; padding: 18px 20px; background: #FFFFFF; border: 1.5px solid var(--border-medium); border-left: 5px solid var(--accent-primary); text-decoration: none; color: inherit; transition: all 0.2s ease;"
        >
          <div style="width: 48px; height: 48px; border-radius: var(--radius-sm); background: #EFF6FF; border: 1.5px solid #BFDBFE; display: flex; align-items: center; justify-content: center; color: var(--accent-primary); flex-shrink: 0;">
            <Fragment set:html={link.icon} />
          </div>

          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 2px;">
              <h2 style="font-size: 1.05rem; font-weight: 800; margin: 0; color: var(--text-primary);">
                {link.title}
              </h2>
              <span class={`card-badge ${link.badgeType}`} style="font-size: 0.65rem; padding: 2px 6px;">
                {link.tag}
              </span>
            </div>

            <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 800; color: var(--accent-primary); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              {link.displayUrl}
            </div>

            <p style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.45;">
              {link.desc}
            </p>
          </div>

          <div style="font-family: var(--font-mono); font-size: 1.1rem; color: var(--accent-primary); font-weight: 900; padding-left: 4px;">
            &rarr;
          </div>
        </a>
      ))}
    </div>

    <!-- Quick Exploration Grid -->
    <div class="bento-card col-12" style="background: #FFFFFF; padding: 20px; border: 1.5px solid var(--border-medium); margin-bottom: 24px;">
      <div style="font-family: var(--font-mono); font-size: 0.74rem; font-weight: 800; color: var(--text-primary); text-transform: uppercase; margin-bottom: 12px;">
        Direct Documentation &amp; Subsystem Links
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
        {subSections.map(sub => (
          <a href={sub.href} style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); text-decoration: none; color: inherit; font-size: 0.80rem; font-weight: 700; transition: all 0.15s ease;">
            <span style="color: var(--text-primary);">{sub.title}</span>
            <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--accent-primary);">&rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Footer Note -->
    <div style="text-align: center; font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-muted); line-height: 1.6;">
      <div>Team Monarchs &bull; Academic Advisor: Dr. K Arun Kumar, B.E., M.E., Ph.D.</div>
      <div>Team Lead: Harish Rohith S &bull; 5 Engineering Researchers &bull; Physical Silicon Validated</div>
    </div>

  </div>
</Layout>
