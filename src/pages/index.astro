        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 20px;">
          <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">PILLAR 03</div>
          <h4 style="font-size: 1.05rem; font-weight: 800; margin: 4px 0 8px;">Warning Dissemination</h4>
          <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">NDMA SACHET CAP-v1.2 compliant alerts, 130dB sirens, and local offline multilingual neural TTS.</p>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 20px;">
          <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">PILLAR 04</div>
          <h4 style="font-size: 1.05rem; font-weight: 800; margin: 4px 0 8px;">Preparedness &amp; Response</h4>
