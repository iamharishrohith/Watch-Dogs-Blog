          <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">PILLAR 03</div>
          <h4 style="font-size: 1.05rem; font-weight: 800; margin: 4px 0 8px;">Warning Dissemination</h4>
          <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">NDMA SACHET CAP-v1.2 compliant alerts, 130dB sirens, and local offline multilingual neural TTS.</p>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 20px;">
          <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">PILLAR 04</div>
          <h4 style="font-size: 1.05rem; font-weight: 800; margin: 4px 0 8px;">Preparedness &amp; Response</h4>
          <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Motorized road barriers, dynamic A* escape graph rerouting, and safe muster verification.</p>
        </div>
      </div>

      <div class="mono" style="font-size: 0.75rem; color: var(--text-muted); text-align: center;">
        NOTE: WATCH-DOGS is an open research prototype architecture inspired by established early-warning principles and physical sensor dynamics.
      </div>
    </div>
  </section>

  <!-- ============================================================
       CLIENT-SIDE INTERACTIVE ENGINE
       ============================================================ -->
  <script is:inline>
    // 1. High-Precision Cyber-Physical Signal Field Engine
    const svg = document.getElementById('signal-svg');
    const btnSim = document.getElementById('btn-fire-sim');

    const nodes = [
      { id: "N01", name: "Ridge Rain Gauge", x: 90, y: 110, elev: "1,840m", type: "Precipitation", val: "58.4 mm/h", color: "#3B82F6", sub: "Tipping Bucket Radar", status: "NORMAL" },
      { id: "N02", name: "Upper Slope Pore Pressure", x: 230, y: 180, elev: "1,620m", type: "Hydraulic", val: "22.1 kPa", color: "#38BDF8", sub: "SS316 Piezometer", status: "WARNING" },
      { id: "N03", name: "Mid-Slope TDR Saturation", x: 380, y: 260, elev: "1,410m", type: "Soil Moisture", val: "96.8 % VWC", color: "#10B981", sub: "1.5m Dual-Depth TDR", status: "CRITICAL" },
      { id: "N07", name: "Headscarp Tilt IMU", x: 540, y: 190, elev: "1,550m", type: "Shear Vector", val: "8.4° (+1.2°/h)", color: "#EF4444", sub: "6-DOF Accel Ring", status: "CODE RED" },
      { id: "N13", name: "Slip-Plane Acoustic Micro-Fracture", x: 690, y: 310, elev: "1,220m", type: "Rock Acoustic", val: "340 counts/s", color: "#F59E0B", sub: "200kHz Hydrophone", status: "ACTIVE TRIP" },
      { id: "N16", name: "Chooralmala Bridge Radar", x: 840, y: 390, elev: "940m", type: "Riparian Stage", val: "h = 4.82m (dh/dt +0.6m/min)", color: "#EC4899", sub: "24GHz FMCW Radar", status: "BARRICADED" },
      { id: "GW01", name: "Valley Command Gateway", x: 980, y: 240, elev: "860m", type: "RPi 5 + LoRa HAT", val: "PINN Mohr-Coulomb 14.2ms", color: "#8B5CF6", sub: "Air-Gapped SX1262 Hub", status: "ONLINE" }
    ];

    let packets = [];
    let animationFrame;

    function renderGisGrid() {
      if (!svg) return;
      svg.innerHTML = '';

      const width = svg.clientWidth || 1100;
      const height = svg.clientHeight || 500;

      // Defs: Gradients and Glow Filters
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.innerHTML = `
        <linearGradient id="terrainGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1E293B" stop-opacity="0.4"/>
          <stop offset="50%" stop-color="#0F172A" stop-opacity="0.6"/>
          <stop offset="100%" stop-color="#020617" stop-opacity="0.9"/>
        </linearGradient>
        <linearGradient id="linkGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.8"/>
          <stop offset="50%" stop-color="#10B981" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0.8"/>
        </linearGradient>
        <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="6" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <pattern id="gisGrid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1F2937" stroke-width="0.75" stroke-dasharray="2,2"/>
        </pattern>
      `;
      svg.appendChild(defs);

      // Background Grid
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('width', '100%');
      rect.setAttribute('height', '100%');
      rect.setAttribute('fill', 'url(#gisGrid)');
      svg.appendChild(rect);

      // Topographic Contour Lines (Stylized Mountain Relief)
      const contourGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      contourGroup.setAttribute('opacity', '0.25');
      const contours = [
        "M 0 100 Q 300 80 600 160 T 1200 200 L 1200 500 L 0 500 Z",
        "M 0 180 Q 350 140 700 240 T 1200 300 L 1200 500 L 0 500 Z",
        "M 0 270 Q 400 220 800 320 T 1200 400 L 1200 500 L 0 500 Z"
      ];
      contours.forEach((d, idx) => {
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#38BDF8');
        path.setAttribute('stroke-width', '1');
        path.setAttribute('stroke-dasharray', '4,4');
        contourGroup.appendChild(path);
      });
      svg.appendChild(contourGroup);

      // LoRa Mesh Multi-Hop Transmission Links
      const linkConnections = [
        [0, 1], [1, 2], [2, 3], [3, 4], [4, 5], [3, 6], [5, 6], [1, 6]
      ];

      linkConnections.forEach(([from, to]) => {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', nodes[from].x);
        line.setAttribute('y1', nodes[from].y);
        line.setAttribute('x2', nodes[to].x);
        line.setAttribute('y2', nodes[to].y);
        line.setAttribute('stroke', '#374151');
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('stroke-dasharray', '3,3');
        svg.appendChild(line);
      });

      // Packet container
      const packetGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      packetGroup.setAttribute('id', 'packet-group');
      svg.appendChild(packetGroup);

      // Render Nodes with Pulsing Radar Rings & Interactive HUD
      nodes.forEach((n, idx) => {
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.style.cursor = 'pointer';

        // Outer radar pulse
        const pulse = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        pulse.setAttribute('cx', n.x);
        pulse.setAttribute('cy', n.y);
        pulse.setAttribute('r', '24');
        pulse.setAttribute('fill', 'none');
        pulse.setAttribute('stroke', n.color);
        pulse.setAttribute('stroke-width', '1');
        pulse.setAttribute('opacity', '0.4');

        const pulseAnim = document.createElementNS('http://www.w3.org/2000/svg', 'animate');
        pulseAnim.setAttribute('attributeName', 'r');
        pulseAnim.setAttribute('values', '16;36;16');
        pulseAnim.setAttribute('dur', (2 + idx * 0.4) + 's');
        pulseAnim.setAttribute('repeatCount', 'indefinite');
        pulse.appendChild(pulseAnim);

        const opacAnim = document.createElementNS('http://www.w3.org/2000/svg', 'animate');
        opacAnim.setAttribute('attributeName', 'opacity');
        opacAnim.setAttribute('values', '0.6;0;0.6');
        opacAnim.setAttribute('dur', (2 + idx * 0.4) + 's');
        opacAnim.setAttribute('repeatCount', 'indefinite');
        pulse.appendChild(opacAnim);

        // Core Node Circle with Glow
        const core = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        core.setAttribute('cx', n.x);
        core.setAttribute('cy', n.y);
        core.setAttribute('r', '15');
        core.setAttribute('fill', '#0B0F19');
        core.setAttribute('stroke', n.color);
        core.setAttribute('stroke-width', '2.5');
        core.setAttribute('filter', 'url(#nodeGlow)');

        // Node ID Text
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', n.x);
        text.setAttribute('y', n.y + 4);
        text.setAttribute('fill', '#ffffff');
        text.setAttribute('font-family', "'JetBrains Mono', monospace");
        text.setAttribute('font-size', '10');
        text.setAttribute('font-weight', '900');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = n.id;

        // Label pill beneath
        const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        label.setAttribute('x', n.x);
        label.setAttribute('y', n.y + 28);
        label.setAttribute('fill', '#9CA3AF');
        label.setAttribute('font-family', "'JetBrains Mono', monospace");
        label.setAttribute('font-size', '9');
        label.setAttribute('font-weight', '600');
        label.setAttribute('text-anchor', 'middle');
        label.textContent = n.elev;

        g.appendChild(pulse);
        g.appendChild(core);
        g.appendChild(text);
        g.appendChild(label);

        g.addEventListener('click', () => {
          document.getElementById('active-node-id').innerText = n.id + ' — ' + n.name;
          document.getElementById('active-node-val').innerHTML = '<span style="color:#ffffff;">' + n.val + '</span> &bull; ' + n.sub;
          triggerPacketBurst(idx);
        });

        svg.appendChild(g);
      });
    }

    // Packet Animation Loop
    function triggerPacketBurst(fromIdx = 0) {
      const targets = [fromIdx + 1, 6];
      targets.forEach(tIdx => {
        if (tIdx < nodes.length && tIdx !== fromIdx) {
          packets.push({
            startX: nodes[fromIdx].x,
            startY: nodes[fromIdx].y,
            endX: nodes[tIdx].x,
            endY: nodes[tIdx].y,
            progress: 0,
            speed: 0.025 + Math.random() * 0.015,
            color: nodes[fromIdx].color
          });
        }
      });
    }

    function animatePackets() {
      const group = document.getElementById('packet-group');
      if (group) {
        group.innerHTML = '';
        for (let i = packets.length - 1; i >= 0; i--) {
          const p = packets[i];
          p.progress += p.speed;

          if (p.progress >= 1) {
            packets.splice(i, 1);
            continue;
          }

          const curX = p.startX + (p.endX - p.startX) * p.progress;
          const curY = p.startY + (p.endY - p.startY) * p.progress;

          const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circle.setAttribute('cx', curX);
          circle.setAttribute('cy', curY);
          circle.setAttribute('r', '4');
          circle.setAttribute('fill', p.color);
          circle.setAttribute('filter', 'url(#nodeGlow)');
          group.appendChild(circle);
        }
      }

      // Auto spawn heartbeat packets
      if (Math.random() < 0.08 && nodes.length > 0) {
        const randFrom = Math.floor(Math.random() * (nodes.length - 1));
        triggerPacketBurst(randFrom);
      }

      animationFrame = requestAnimationFrame(animatePackets);
    }

    renderGisGrid();
    animatePackets();

    if (btnSim) {
      btnSim.addEventListener('click', () => {
        for (let i = 0; i < nodes.length - 1; i++) {
          setTimeout(() => triggerPacketBurst(i), i * 140);
        }
      });
    }


    // 2. Sensor Wall Modal Interaction
    const sensorData = {
      PIEZOMETER: { id: "S-01", title: "Vibrating Wire Pore Pressure Transducer", desc: "Buried 1.5m deep into the weathered slip plane inside a porous ceramic filter tip. Measures pore-water pressure transients u.", measurement: "Pore Water Pressure (u)", signal: "Plucked Frequency (450-1200 Hz)", sampling: "10 Hz Burst / 0.1 Hz Sleep", roleTitle: "Primary Liquefaction Indicator", roleDesc: "Enters the Mohr-Coulomb effective stress equation &tau; = c' + (&sigma; - u) tan &phi;'." },
      TDR: { id: "S-02", title: "Dual-Depth Capacitive TDR Probe", desc: "Monitors volumetric soil moisture at 0.5m and 1.5m to track the downward infiltration front.", measurement: "Volumetric Water Content (%VWC)", signal: "0-3.3V Analog Voltage", sampling: "1 Hz Burst / 0.1 Hz Sleep", roleTitle: "Capillary Suction Collapse", roleDesc: "Predicts when negative matric suction collapses into positive hydrostatic driving pressure." },
      ACOUSTIC: { id: "S-03", title: "Sub-Surface Acoustic Emission Hydrophone", desc: "Captures high-frequency elastic stress waves emitted during inter-granular rock micro-shearing.", measurement: "150-250 kHz Acoustic Ring-Down", signal: "Envelope Detector Pulse Counts", sampling: "Continuous Wake-on-Interrupt", roleTitle: "48-Minute Mechanical Precursor", roleDesc: "Detects micro-cracking before bulk detachment occurs, giving critical evacuation lead time." },
      IMU: { id: "S-04", title: "6-DOF InvenSense IMU Tilt Sensor", desc: "Measures sub-degree inclination angles and high-frequency accelerations on the headscarp ridge.", measurement: "Slope Angle Beta (&deg;) + Accel (g)", signal: "I2C 400kHz Digital Bus", sampling: "100 Hz ISR Ring Buffer", roleTitle: "Dynamic Slope Acceleration", roleDesc: "Quantifies actual physical displacement velocity and angular tilting." },
      RADAR: { id: "S-05", title: "24 GHz FMCW Riparian River Radar", desc: "Suspended from bridge abutments to measure stage height and water surface flow velocity.", measurement: "Stage Depth h (mm) + Velocity (m/s)", signal: "RS-485 Modbus RTU", sampling: "10 Hz Continuous", roleTitle: "Hydrodynamic Surge Detection", roleDesc: "Tracks Saint-Venant flood wave transit velocity dh/dt to close bridges downstream." },
      TURBIDITY: { id: "S-06", title: "TS-300B Optical Turbidity Transducer", desc: "Measures suspended particulate matter and debris density in riparian channels.", measurement: "Turbidity (0 - 3000 NTU)", signal: "0-4.5V Analog Output", sampling: "1 Hz Continuous", roleTitle: "Debris Flow Slurry Detector", roleDesc: "Separates clear water flood waves from high-density debris mudflows." },
      BME: { id: "S-07", title: "BME280 Environmental Microclimate Core", desc: "Measures ambient temperature, barometric pressure, and relative humidity for vapor pressure deficit.", measurement: "Temp (&deg;C), RH (%), Press (hPa)", signal: "I2C 400kHz Digital Bus", sampling: "0.1 Hz Sleep Cycle", roleTitle: "Atmospheric Boundary State", roleDesc: "Calculates vapor pressure deficit (VPD) for wildfire and storm intensity modeling." },
      CRACK: { id: "S-08", title: "LVDT Precision Extensometer Crackmeter", desc: "Mounted across surface tension cracks to measure millimeter-scale widening in real time.", measurement: "Displacement (0 - 50 mm)", signal: "Differential Voltage &plusmn;5V", sampling: "10 Hz Continuous", roleTitle: "Tension Crack Propagation", roleDesc: "Direct evidence of impending detachment wedge failure." }
    };

    document.querySelectorAll('.sensor-wall-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.sensor-wall-item').forEach(i => i.classList.remove('selected'));
        item.classList.add('selected');

        const key = item.getAttribute('data-sensor');
        const data = sensorData[key];
        if (data) {
          document.getElementById('detail-sensor-id').innerText = 'TRANSDUCER SPECIFICATION: ' + data.id;
          document.getElementById('detail-sensor-title').innerText = data.title;
          document.getElementById('detail-sensor-desc').innerText = data.desc;
          document.getElementById('detail-measurement').innerText = data.measurement;
          document.getElementById('detail-signal').innerText = data.signal;
          document.getElementById('detail-sampling').innerText = data.sampling;
          document.getElementById('detail-role-title').innerText = data.roleTitle;
          document.getElementById('detail-role-desc').innerText = data.roleDesc;
        }
      });
    });

    // 3. Scenario Selector Interaction
    const scenarioData = {
      WAYANAD: {
        badge: "HAZARD DOMAIN: GEOTECHNICAL SHEAR",
        title: "Wayanad Mountain Landslide & Debris Slurry",
        state: "MODEL: MOHR-COULOMB + RICHARDS",
        signals: "&bull; Pore Water Pressure (u)<br />&bull; 150-250kHz Acoustic Ringing<br />&bull; Dual-Depth TDR Soil Saturation",
        mech: "Continuous rainfall drives matric suction collapse at 1.5m slip plane depth, converting soil to high-velocity Newtonian fluid.",
        action: "64ms 130dB Siren Relay Trip &bull; Close Chooralmala Bridge Barricade &bull; Vector Crowds to High Ridge.",
        equation: "FS = [ c' + (&gamma; z cos^2&beta; - u) tan &phi;' ] / [ &gamma; z sin &beta; cos &beta; ]"
      },
      KEDARNATH: {
        badge: "HAZARD DOMAIN: HYDROLOGICAL SURGE",
        title: "Kedarnath Glacial Outburst & River Surge",
        state: "MODEL: 2D SAINT-VENANT SHALLOW WATER",
        signals: "&bull; 24GHz FMCW Water Stage (h)<br />&bull; Hydraulic Surge Rate (dh/dt)<br />&bull; In-Situ River Bed Pressure",
        mech: "Moraine dam breach releases 15-meter hydraulic surge wave carrying 40-tonne boulders down Mandakini river corridor.",
        action: "Deploy Highway Underpass Boom Barriers &bull; Sound 130dB River Basin Sirens &bull; Open Emergency Siphon Relief.",
        equation: "&part;A/&part;t + &part;Q/&part;x = q,   &part;Q/&part;t + &part;/&part;x(Q^2/A) + gA &part;h/&part;x = gA(S_0 - S_f)"
      },
      DELHI: {
        badge: "HAZARD DOMAIN: URBAN INUNDATION",
        title: "Delhi Urban Underpass & Drainage Flood",
        state: "MODEL: SWMM CULVERT HYDRODYNAMICS",
        signals: "&bull; Ultrasonic Culvert Stage<br />&bull; Submersible Float Switches<br />&bull; Drainage Flow Velocity",
        mech: "Intense convective downpour exceeds storm drain pump capacity, rapidly drowning underpasses in &lt;15 minutes.",
        action: "Trip Optocoupled Submersible High-Volume Pumps &bull; Close Underpass Road Boom Barriers in 108ms.",
        equation: "Q = C_d A \sqrt{2 g \Delta H}"
      },
      SIMILIPAL: {
        badge: "HAZARD DOMAIN: BIOMASS PYROLYSIS",
        title: "Similipal Biosphere Wildfire Spread",
        state: "MODEL: ROTHERMEL SURFACE FIRE MODEL",
        signals: "&bull; Canopy Temperature Gradient<br />&bull; MOS VOC Gas Sensors<br />&bull; Vapor Pressure Deficit (VPD)",
        mech: "Extreme VPD and dry canopy wind gusts propagate rapid surface flame front across deciduous tiger reserve.",
        action: "Vector SAR Drones &bull; Alert Forestry Outposts &bull; Activate High-Pressure Misting Line Relays.",
        equation: "R = [ I_rx &bull; &xi; &bull; (1 + &Phi;_w + &Phi;_s) ] / [ &rho;_b &bull; &epsilon; &bull; Q_ig ]"
      },
      INDUSTRIAL: {
        badge: "HAZARD DOMAIN: TOXIC DISPERSION",
        title: "Industrial Toxic Chemical Gas Release",
        state: "MODEL: GAUSSIAN PLUME ATMOSPHERIC DISPERSION",
        signals: "&bull; MOS Gas Array (Cl2, NH3, H2S)<br />&bull; Ultrasonic Anemometer Wind Vector<br />&bull; Atmospheric Inversion Temp",
        mech: "High-pressure valve breach releases dense chlorine vapor forming ground-hugging lethal concentration plume.",
        action: "Seal Factory HVAC Intakes &bull; Vector Perimeter Siren Grid &bull; Evacuate Cross-Wind Escape Corridors.",
        equation: "C(x,y,z) = [ Q / (2&pi; u &sigma;_y &sigma;_z) ] &bull; exp(-y^2 / 2&sigma;_y^2) &bull; exp(-(z-H)^2 / 2&sigma;_z^2)"
      }
    };

    document.querySelectorAll('.scenario-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.scenario-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const key = btn.getAttribute('data-scenario');
        const data = scenarioData[key];
        if (data) {
          document.getElementById('scen-badge').innerText = data.badge;
          document.getElementById('scen-title').innerText = data.title;
          document.getElementById('scen-state').innerText = data.state;
          document.getElementById('scen-signals').innerHTML = data.signals;
          document.getElementById('scen-mech').innerText = data.mech;
          document.getElementById('scen-action').innerHTML = data.action;
          document.getElementById('scen-equation').innerText = data.equation;
        }
      });
    });

    // 4. Failure Lab Trigger Interaction
    const failureScenarios = {
      NODE_OFFLINE: {
        badge: "FAULT CONDITION: SENSOR NODE OFFLINE",
        title: "Node N07 Sub-Surface Cable Severed by Rockfall",
        m1: "94.4% (-5.6%)",
        m2: "81.2% (Bounded)",
        m3: "CROSS-VALIDATION",
        explanation: "Autonomous Fault Tolerance: When N07 telemetry drops out, the Kalman filter dynamically increases the covariance weight of surrounding nodes N05 (Pore Pressure) and N03 (Moisture). The PINN switches from direct displacement tracking to hydro-mechanical soil moisture inference, avoiding false trips while retaining early warning coverage."
      },
      PACKET_LOSS: {
        badge: "FAULT CONDITION: 50% RADIO PACKET LOSS",
        title: "Severe Monsoon Rain Fade & RF Attenuation",
        m1: "50.0% (-50.0%)",
        m2: "74.8% (Conservative)",
        m3: "ADAPTIVE DATA RATE",
        explanation: "LoRa Mesh Adaptation: The SX1262 transceiver detects dropped packet acknowledgments and automatically steps up spreading factor from SF7 to SF10 (+6dB link margin). The edge state machine holds last-known physically valid states with exponential decay uncertainty bounds."
      },
      GATEWAY_FALLBACK: {
        badge: "FAULT CONDITION: PRIMARY GATEWAY LOSS",
        title: "Lightning Strike Hits Master Gateway GW01",
        m1: "100% (Rerouted)",
        m2: "92.0% (Hot Standby)",
        m3: "FAILOVER MESH",
        explanation: "Autonomous Gateway Failover: Directed Acyclic Graph (DAG) routing dynamically promotes Sentinel Node N05 to acting Micro-Gateway. Critical siren trip commands are autonomously broadcast peer-to-peer over raw LoRa packets without waiting for gateway restoration."
      },
      CONFLICTING_DATA: {
        badge: "FAULT CONDITION: SENSOR CONFLICT ANOMALY",
        title: "Rain Gauge Spikes but Soil Moisture Remains Dry",
        m1: "100% (Filtered)",
        m2: "96.4% (Rejection)",
        m3: "3-TIER VOTING",
        explanation: "False Alarm Prevention: The Bayesian concordance engine recognizes an impossible physical condition (rain without infiltration). It isolates the rain gauge as an animal disturbance or leaf blockage, preventing a false evacuation siren trip."
      }
    };

    document.querySelectorAll('.failure-trigger-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.failure-trigger-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const key = btn.getAttribute('data-fail');
        const data = failureScenarios[key];
        if (data) {
          document.getElementById('fail-badge').innerText = data.badge;
          document.getElementById('fail-title').innerText = data.title;
          document.getElementById('fail-metric-1').innerText = data.m1;
          document.getElementById('fail-metric-2').innerText = data.m2;
          document.getElementById('fail-metric-3').innerText = data.m3;
          document.getElementById('fail-explanation').innerHTML = '<strong>Autonomous Fault Tolerance:</strong> ' + data.explanation;
        }
      });
    });
  </script>
</Layout>
