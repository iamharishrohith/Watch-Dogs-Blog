---
import Layout from '../layouts/Layout.astro';
---

<Layout title="WATCH-DOGS | Edge-Intelligent Multi-Hazard Disaster Early Warning">
  
  <!-- ============================================================
       00. OPENING EXPERIENCE & EDITORIAL STATEMENT
       ============================================================ -->
  <section class="section-editorial" style="min-height: 80vh; display: flex; align-items: center; border-bottom: 1px solid var(--border-subtle);">
    <div class="container-narrow">
      <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 20px;">
        <img src="/iCONS/sih_2026_lockup_logo.png" alt="SIH 2026" style="height: 32px; object-fit: contain;" />
        <span style="color: var(--border-medium);">|</span>
        <div class="section-label" style="margin-bottom: 0;">WATCH-DOGS / RESEARCH PUBLICATION 01</div>
      </div>
      
      <h1 class="headline-display" style="margin-bottom: 24px;">
        BEFORE A DISASTER<br />
        BECOMES AN EVENT,<br />
        IT LEAVES SIGNALS.
      </h1>

      <div style="display: flex; gap: 16px; align-items: center; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 36px; flex-wrap: wrap;">
        <span>RAIN</span>
        <span style="color: var(--text-muted);">&rarr;</span>
        <span>SATURATION</span>
        <span style="color: var(--text-muted);">&rarr;</span>
        <span>PORE PRESSURE</span>
        <span style="color: var(--text-muted);">&rarr;</span>
        <span>DEFORMATION</span>
        <span style="color: var(--text-muted);">&rarr;</span>
        <span style="color: var(--accent-hazard);">FAILURE</span>
      </div>

      <p class="lead-paragraph" style="margin-bottom: 32px;">
        Disasters do not begin when sirens sound or satellite images arrive. They unfold through progressive physical state changes in the earth, atmosphere, and infrastructure. WATCH-DOGS is an open research architecture exploring how distributed in-situ sensors, low-power radio mesh, and edge-computed multi-sensor fusion can detect catastrophic pre-failure precursors.
      </p>

      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <a href="#signal-field" style="background: var(--bg-contrast); color: #ffffff; padding: 12px 24px; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600;">ENTER THE RESEARCH &darr;</a>
        <a href="#lab-testbed" style="background: var(--bg-secondary); border: 1px solid var(--border-subtle); color: var(--text-primary); padding: 12px 24px; border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600;">INSPECT HARDWARE BENCHMARK &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       01. HERO VISUAL: INTERACTIVE TECHNICAL SIGNAL FIELD
       ============================================================ -->
  <section id="signal-field" class="section-editorial" style="background: var(--bg-secondary);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
          <div class="section-label">INTERACTIVE PROTOTYPE</div>
          <h2 style="font-size: 2.0rem; font-weight: 800; letter-spacing: -0.03em;">Interactive In-Situ Signal Pathway</h2>
        </div>
        <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-secondary);">
          CLICK ANY NODE TO TRACE PACKET PROPAGATION
        </div>
      </div>

      <div id="signal-field-container">
        <svg id="signal-svg" width="100%" height="100%" style="display: block; cursor: crosshair;"></svg>
      </div>

      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; font-family: var(--font-mono); font-size: 0.78rem;">
        <div style="background: #ffffff; padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
          <div style="color: var(--text-muted); margin-bottom: 4px;">ACTIVE SENSOR NODE</div>
          <div id="active-node-id" style="font-size: 1.1rem; font-weight: 800; color: var(--accent-primary);">N07 (Headscarp Tilt)</div>
          <div id="active-node-val" style="color: var(--text-secondary); margin-top: 2px;">Tilt = 8.4&deg; | d&beta;/dt = +1.2&deg;/h</div>
        </div>
        <div style="background: #ffffff; padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
          <div style="color: var(--text-muted); margin-bottom: 4px;">RF PROTOCOL</div>
          <div style="font-size: 1.1rem; font-weight: 800;">868 MHz LoRa</div>
          <div style="color: var(--text-secondary); margin-top: 2px;">32-Byte Packed Binary Frame</div>
        </div>
        <div style="background: #ffffff; padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
          <div style="color: var(--text-muted); margin-bottom: 4px;">EDGE GATEWAY</div>
          <div style="font-size: 1.1rem; font-weight: 800;">GW01 &bull; RPi 5</div>
          <div style="color: var(--text-secondary); margin-top: 2px;">14.2ms LibTorch PINN Pass</div>
        </div>
        <div style="background: #ffffff; padding: 16px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
          <div style="color: var(--text-muted); margin-bottom: 4px;">SYSTEM STATUS</div>
          <div id="active-system-state" style="font-size: 1.1rem; font-weight: 800; color: var(--accent-hazard);">CODE RED (Actuated)</div>
          <div style="color: var(--text-secondary); margin-top: 2px;">Factor of Safety FS = 0.94</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       02. SCROLL CHAPTER 01: THE PROBLEM (SINGLE VS CORRELATED)
       ============================================================ -->
  <section id="evidence" class="section-editorial">
    <div class="container">
      <div class="section-label">CHAPTER 01 / THE CORE DILEMMA</div>
      <h2 class="headline-display">
        "ONE SENSOR CAN TELL YOU WHAT HAPPENED.<br />
        CONTEXT TELLS YOU WHY IT MATTERS."
      </h2>

      <div class="split-evidence-grid">
        <!-- Left: Single Sensor Isolation -->
        <div class="evidence-panel">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <span style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted);">ISOLATED OBSERVATION</span>
            <span style="background: #FEF2F2; color: var(--accent-hazard); font-family: var(--font-mono); font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; font-weight: 700;">HIGH UNCERTAINTY</span>
          </div>

          <div style="font-family: var(--font-mono); font-size: 2.8rem; font-weight: 900; color: var(--text-primary); margin-bottom: 8px;">
            N07: &beta; = 5.2&deg;
          </div>
          <div style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 24px;">
            Single-axis inclination tilt anomaly detected on ridge mast.
          </div>

          <div style="background: var(--bg-secondary); padding: 16px; border-radius: var(--radius-sm); font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;">
            <strong>Ambiguity:</strong> Is this progressive geotechnical slope shearing, an animal colliding with the sensor post, strong wind buffeting, or soil creep? A single sensor cannot verify causality.
          </div>
        </div>

        <!-- Right: Correlated Multi-Sensor Evidence -->
        <div class="evidence-panel active-fusion">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <span style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--accent-primary); font-weight: 700;">MULTI-SENSOR EVIDENCE</span>
            <span style="background: #EFF6FF; color: var(--accent-primary); font-family: var(--font-mono); font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; font-weight: 700;">CONVERGENT PROOF</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 20px;">
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: 4px;">Rain Infiltration: <strong>+42 mm/h &uarr;</strong></div>
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: 4px;">Soil Saturation: <strong>94.2% VWC &uarr;</strong></div>
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-xs);">Pore Pressure: <strong>34.5 kPa &uarr;</strong></div>
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-xs);">Acoustic Fractures: <strong>240 c/s &uarr;</strong></div>
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-xs);">Displacement: <strong>+18 mm &uarr;</strong></div>
            <div style="background: #ffffff; padding: 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-xs);">Tilt Vector: <strong>+5.2&deg; (Slope D) &uarr;</strong></div>
          </div>

          <div style="background: #ffffff; border-left: 3px solid var(--accent-hazard); padding: 14px; border-radius: var(--radius-xs); font-size: 0.85rem; color: var(--text-primary); font-weight: 600;">
            HAZARD INTELLIGENCE: Hydro-mechanical failure plane verified across 3 distinct physical modalities. False alarm probability &lt; 0.2%.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       03. PHYSICAL LAB WORKBENCH & REAL PROTOTYPE PROOFS
       ============================================================ -->
  <section id="lab-testbed" class="section-editorial" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-label">CHAPTER 03 / HARDWARE VERIFICATION TESTBED</div>
      <h2 style="font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px;">Physical Testbed &amp; Live Hardware Instrumentation</h2>
      <p style="color: var(--text-secondary); max-width: 720px; margin-bottom: 36px;">
        Zero mock data. Direct photographs of our physical laboratory testbed verifying FreeRTOS task scheduling, SX1262 LoRa transmission, and analog sensor signal conditioning.
      </p>

      <!-- First Row: Real Lab Prototypes -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/prototypes/prototype_workbench_overview.jpeg" alt="Complete Workbench Testbed" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">BENCHMARK 01</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">Integrated Sensor Testbed</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Physical telemetry node equipped with ADC DMA ring buffer, 15&mu;A deep sleep, and 868MHz +22dBm radio frontend.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/prototypes/prototype_sensor_breadboard.jpeg" alt="Breadboard Wiring" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-success); font-weight: 800;">BENCHMARK 02</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">ESP32-S3 &amp; LoRa Circuit</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Direct SPI/I2C/ADC interface wiring with noise decoupling filters and precision analog frontends.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/prototypes/prototype_testbench_calibration.jpeg" alt="Analog Calibration" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-warning); font-weight: 800;">BENCHMARK 03</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">Analog Signal Calibration</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Dynamic calibration testing for in-situ piezometers, moisture probes, and acoustic stress sensors.</p>
          </div>
        </div>
      </div>

      <!-- Second Row: Miniature Physical Hazard Simulation & Deployment -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/miniature-test-images/WhatsApp Image 2026-09-25 at 12.25.03 AM.jpeg" alt="Soil Chamber Simulation" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-primary); font-weight: 800;">PHYSICAL RIG 01</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">Soil Column Infiltration</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Hydro-mechanical saturation chamber verifying matric suction loss under simulated monsoon downpours.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/miniature-test-images/WhatsApp Image 2026-09-25 at 12.25.04 AM.jpeg" alt="Slope Incline Rig" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-hazard); font-weight: 800;">PHYSICAL RIG 02</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">Slope Stability Shear Rig</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">Variable angle tilt testbed measuring critical Mohr-Coulomb shear threshold and acoustic release ringing.</p>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); overflow: hidden;">
          <img src="/disaster-photos/exact_sensor_node_prototype.jpg" alt="Weatherproof Field Sentinel" style="width: 100%; height: 220px; object-fit: cover;" />
          <div style="padding: 16px;">
            <div class="mono" style="font-size: 0.70rem; color: var(--accent-success); font-weight: 800;">FIELD DEPLOYMENT</div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin: 2px 0 6px;">Weatherproof Sentinel Node</h4>
            <p style="font-size: 0.80rem; color: var(--text-secondary); line-height: 1.5;">IP67 solar-harvested autonomous enclosure with SMA fiberglass omni antenna for 20–40km LoRa mesh.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       04. SCROLL CHAPTER 04: THE PHYSICAL SENSOR WALL
       ============================================================ -->
  <section id="signals" class="section-editorial">
    <div class="container">
      <div class="section-label">CHAPTER 04 / PHYSICAL SENSOR SPECIFICATIONS</div>
      <h2 class="headline-display" style="font-size: 2.8rem; margin-bottom: 12px;">"Every decision begins with an observation."</h2>
      <p style="color: var(--text-secondary); max-width: 680px; margin-bottom: 32px;">
        Click any physical transducer modality to inspect its excitation physics, sampling profile, and role in the hazard detection pipeline.
      </p>

      <div class="sensor-wall-grid" id="sensor-wall">
        <div class="sensor-wall-item selected" data-sensor="PIEZOMETER">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-01</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Piezometer</div>
          <div class="mono" style="font-size: 0.74rem;">0 - 100 kPa</div>
        </div>
        <div class="sensor-wall-item" data-sensor="TDR">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-02</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Soil Moisture</div>
          <div class="mono" style="font-size: 0.74rem;">0 - 100% VWC</div>
        </div>
        <div class="sensor-wall-item" data-sensor="ACOUSTIC">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-03</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Slip Acoustics</div>
          <div class="mono" style="font-size: 0.74rem;">150 - 250 kHz</div>
        </div>
        <div class="sensor-wall-item" data-sensor="IMU">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-04</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">6-DOF IMU</div>
          <div class="mono" style="font-size: 0.74rem;">&plusmn;16g / &plusmn;2000&deg;/s</div>
        </div>
        <div class="sensor-wall-item" data-sensor="RADAR">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-05</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">River Radar</div>
          <div class="mono" style="font-size: 0.74rem;">24 GHz FMCW</div>
        </div>
        <div class="sensor-wall-item" data-sensor="TURBIDITY">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-06</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Turbidity</div>
          <div class="mono" style="font-size: 0.74rem;">0 - 3000 NTU</div>
        </div>
        <div class="sensor-wall-item" data-sensor="BME">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-07</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Microclimate</div>
          <div class="mono" style="font-size: 0.74rem;">Temp/RH/Press</div>
        </div>
        <div class="sensor-wall-item" data-sensor="CRACK">
          <div class="mono" style="font-size: 0.70rem; color: var(--text-muted);">S-08</div>
          <div style="font-weight: 800; font-size: 1.05rem; margin: 4px 0;">Crackmeter</div>
          <div class="mono" style="font-size: 0.74rem;">0 - 50 mm LVDT</div>
        </div>
      </div>

      <!-- Sensor Detail Card -->
      <div id="sensor-detail-panel" style="background: var(--bg-secondary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center;">
        <div>
          <span class="mono" id="detail-sensor-id" style="font-size: 0.75rem; color: var(--accent-primary); font-weight: 800;">TRANSDUCER SPECIFICATION: S-01</span>
          <h3 id="detail-sensor-title" style="font-size: 1.5rem; font-weight: 800; margin: 4px 0 10px;">Vibrating Wire Pore Pressure Transducer</h3>
          <p id="detail-sensor-desc" style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px;">
            Buried 1.5m deep into the weathered slip plane inside a porous ceramic filter tip. Measures pore-water pressure transients (u) that reduce effective shear stress across the Mohr-Coulomb failure envelope.
          </p>
          <div class="mono" style="font-size: 0.78rem; display: flex; flex-direction: column; gap: 6px; color: var(--text-secondary);">
            <div><strong>Physical Measurement:</strong> <span id="detail-measurement">Pore Water Pressure (u)</span></div>
            <div><strong>Excitation &amp; Signal:</strong> <span id="detail-signal">Plucked Frequency (450-1200 Hz)</span></div>
            <div><strong>Sampling Frequency:</strong> <span id="detail-sampling">10 Hz Burst / 0.1 Hz Sleep</span></div>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 20px;">
          <div class="mono" style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 6px;">ROLE IN HAZARD PHYSICS MODEL</div>
          <div id="detail-role-title" style="font-weight: 800; font-size: 1.1rem; color: var(--accent-hazard); margin-bottom: 8px;">
            Primary Liquefaction Indicator
          </div>
          <p id="detail-role-desc" style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.55;">
            Directly enters the Mohr-Coulomb effective stress equation &tau; = c' + (&sigma; - u) tan &phi;'. As pore pressure rises to overcome normal stress, the factor of safety drops below 1.00, triggering immediate relay trip.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       05. SCROLL CHAPTER 10: MULTI-HAZARD SCENARIOS & CASE STUDIES
       ============================================================ -->
  <section id="scenarios" class="section-editorial" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-label">CHAPTER 05 / MULTI-HAZARD CASE STUDIES</div>
      <h2 class="headline-display" style="font-size: 2.8rem; margin-bottom: 12px;">One Architecture. Many Hazards.</h2>
      <p style="color: var(--text-secondary); max-width: 720px; margin-bottom: 24px;">
        Select a disaster scenario to dynamically adapt the underlying physical sensors, mathematical models, and forensic field evidence.
      </p>

      <!-- Scenario Selector Buttons -->
      <div class="scenario-nav-bar" id="scenario-nav">
        <button class="scenario-btn active" data-scenario="WAYANAD">WAYANAD (Landslide)</button>
        <button class="scenario-btn" data-scenario="KEDARNATH">KEDARNATH (Flash Flood &amp; GLOF)</button>
        <button class="scenario-btn" data-scenario="DELHI">DELHI (Urban Flood)</button>
        <button class="scenario-btn" data-scenario="SIMILIPAL">SIMILIPAL (Wildfire)</button>
        <button class="scenario-btn" data-scenario="INDUSTRIAL">INDUSTRIAL (Gas Release)</button>
      </div>

      <!-- Dynamic Scenario Content Panel -->
      <div id="scenario-content-panel" style="background: #ffffff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <div>
            <span class="mono" id="scen-badge" style="font-size: 0.72rem; color: var(--accent-primary); font-weight: 800;">HAZARD DOMAIN: GEOTECHNICAL SHEAR</span>
            <h3 id="scen-title" style="font-size: 1.6rem; font-weight: 800; margin: 4px 0;">Wayanad Mountain Landslide &amp; Debris Slurry</h3>
          </div>
          <span class="status-badge" id="scen-state" style="background: var(--bg-secondary);">MODEL: MOHR-COULOMB + RICHARDS</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
          <div style="background: var(--bg-secondary); padding: 18px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);">
            <div class="mono" style="font-size: 0.72rem; color: var(--text-muted); margin-bottom: 6px;">PRIMARY IN-SITU SIGNALS</div>
            <div id="scen-signals" style="font-size: 0.88rem; font-weight: 700; color: var(--text-primary); line-height: 1.5;">
              &bull; Pore Water Pressure (u)<br />
              &bull; 150-250kHz Acoustic Ringing<br />
              &bull; Dual-Depth TDR Soil Saturation
            </div>
          </div>

